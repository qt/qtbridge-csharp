<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Keep package cache inside the repo to avoid stale cross-project global cache issues -->
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <!-- local feed -->
    <add key="qt.io" value="nuget/local" />
    <!-- fall back to nuget.org -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
