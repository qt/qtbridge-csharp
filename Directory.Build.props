<Project>
  <PropertyGroup>
    <!--
      Allow net8.0 executables and test hosts to run on newer installed .NET runtimes,
      such as .NET 10 instead of requiring an exact .NET 8 runtime on the machine.
    -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <!--
    Optional, git-ignored user settings, such as QtDir, QtDotNetProfiler, QtDotNetSafeMethod
    or QtExportAs etc.
  -->
  <Import Project="Directory.Build.props.user"
    Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />
</Project>
