{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src/Qt.Bridge.CSharp.Api",
          "files": [ "**/*.csproj" ]
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "api/**.yml" ]
      },
      {
        "files": [
          "toc.yml",
          "index.md",
          "api-reference.md",
          "introduction.md",
          "getting-started.md",
          "getting-started-windows-visual-studio.md",
          "getting-started-windows-cli-vscode.md",
          "getting-started-linux.md",
          "csharp-and-qml.md",
          "existing-csharp-projects.md",
          "resources.md",
          "templates-and-examples.md",
          "visual-studio-workflow.md",
          "release-status.md"
        ]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appName": "Qt Bridge for C#",
      "_appTitle": "Qt Bridge for C#",
      "_appLogoPath": "public/qt.svg",
      "_appFaviconPath": "public/qt.svg",
      "_enableSearch": true,
      "_appFooter": "<abbr title=\"Copyright\">&copy;</abbr> 2026 The Qt Company Ltd. Documentation contributions included herein are the copyrights of their respective owners. The documentation provided herein is licensed under the terms of the <a href=\"http://www.gnu.org/licenses/fdl.html\">GNU Free Documentation License version 1.3</a> as published by the Free Software Foundation. Qt and respective logos are <a href=\"https://doc.qt.io/qt/trademarks.html\">trademarks</a> of The Qt Company Ltd. in Finland and/or other countries worldwide. All other trademarks are property of their respective owners.<br><br>"
    },
    "template": [ "default", "modern", "template" ]
  }
}
