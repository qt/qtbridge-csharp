{
    "$schema": "http://json.schemastore.org/template",
    "author": "The Qt Company Ltd.",
    "identity": "Qt.Bridge.CSharp.QMLFile",
    "groupIdentity": "Qt.Bridge.CSharp.Item.Qml",
    "name": "QML File",
    "description": "A new QML file for a Qt Bridge for C# project.",
    "shortName": "qml",
    "classifications": [ "Qt Bridge for C#", "QML", "Item" ],
    "generatorVersions": "[1.0.0.0-*)",
    "sourceName": "NewFile",
    "defaultName": "NewFile",
    "preferDefaultName": true,
    "precedence": "0",
    "tags": {
        "language": "C#",
        "type": "item"
    },
    "primaryOutputs": [ { "path": "NewFile.qml" } ],
    "constraints": {
        "csharp-only": {
            "type": "project-capability",
            "args": "CSharp"
        }
    }
}
