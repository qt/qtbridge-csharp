{
    "$schema": "http://json.schemastore.org/template",
    "author": "The Qt Company Ltd.",
    "identity": "Qt.Bridge.CSharp.Project",
    "groupIdentity": "Qt.Bridge.CSharp.App",
    "name": "Qt Bridge for C# Application",
    "description": "A project for creating a Qt Bridge for C# application with a C# backend and QML user interface.",
    "shortName": "qt",
    "classifications": [ "Qt Bridge for C#", "Qt", "Desktop", "Windows", "Linux" ],
    "sourceName": "NewProject",
    "preferNameDirectory": true,
    "tags": {
        "language": "C#",
        "type": "project"
    },
    "primaryOutputs": [
        {
            "path": "NewProject.csproj"
        }
    ],
    "symbols": {
        "SampleCode": {
            "type": "parameter",
            "datatype": "bool",
            "defaultValue": "false",
            "displayName": "Add sample code to project",
            "description": "Select this option to add sample code to the C# and QML source files."
        },
        "Framework": {
            "type": "parameter",
            "datatype": "choice",
            "defaultValue": "net8.0",
            "replaces": "net8.0",
            "displayName": "Target framework",
            "description": "The target framework for the generated project.",
            "choices": [
                {
                    "choice": "net8.0",
                    "description": ".NET 8"
                },
                {
                    "choice": "net9.0",
                    "description": ".NET 9"
                },
                {
                    "choice": "net10.0",
                    "description": ".NET 10"
                }
            ]
        },
        "CopyrightHeader":{
            "type": "computed",
            "datatype":"bool",
            "value": "false"
        }
    }
}
