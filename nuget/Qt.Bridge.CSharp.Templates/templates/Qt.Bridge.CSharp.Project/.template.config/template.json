{
    "$schema": "http://json.schemastore.org/template",
    "author": "qt.io",
    "identity": "Qt.Bridge.CSharp.Project",
    "groupIdentity": "Qt.Bridge.CSharp.App",
    "name": "QML Application",
    "description": "A project for creating a C# + QML application.",
    "shortName": "qt",
    "classifications": [ "QML", "Qt", "Windows", "Desktop" ],
    "sourceName": "NewProject",
    "preferNameDirectory": true,
    "tags": {
        "language": "C#",
        "type": "project"
    },
    "constraints": {
        "win-only": {
            "type": "os",
            "args": "Windows"
        }
    },
    "primaryOutputs": [
        {
            "path": "NewProject.csproj"
        }
    ],
    "symbols": {
        "SampleCode": {
            "type": "parameter",
            "datatype": "bool",
            "defaultValue": "false",
            "displayName": "Add sample code to project",
            "description": "Select this option to add sample code to the C# and QML source files."
        },
        "CopyrightHeader":{
            "type": "computed",
            "datatype":"bool",
            "value": "false"
        }
    }
}
