<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>

    <!-- Prefer explicit RuntimeIdentifier if provided -->
    <QtRid Condition="'$(QtRid)' == '' AND '$(RuntimeIdentifier)' != ''"
      >$(RuntimeIdentifier)</QtRid>

  </PropertyGroup>

  <!-- Determine and normalize architecture if RID not already set -->
  <Import Condition="'$(QtRid)' == '' AND '$(QtArchPropsImported)' != 'true'"
    Project="$(MSBuildThisFileDirectory)build/qt_arch.props" />

  <PropertyGroup>

    <!-- Default architecture -->
    <QtArch Condition="'$(QtArch)' == ''">x64</QtArch>

    <!-- Construct RID if still missing -->
    <QtRid Condition="'$(QtRid)' == '' AND $([MSBuild]::IsOSPlatform('Windows'))"
      >win-$(QtArch)</QtRid>
    <QtRid Condition="'$(QtRid)' == '' AND $([MSBuild]::IsOSPlatform('Linux'))"
      >linux-$(QtArch)</QtRid>
    <QtRid Condition="'$(QtRid)' == '' AND $([MSBuild]::IsOSPlatform('OSX'))"
      >osx-$(QtArch)</QtRid>

  </PropertyGroup>
</Project>
