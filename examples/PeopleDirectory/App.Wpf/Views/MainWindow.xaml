<Window
  x:Class="PeopleDirectory.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="{Binding Title}"
  Width="1100"
  Height="720"
  MinWidth="760"
  MinHeight="520"
  WindowStartupLocation="CenterScreen"
  Background="{DynamicResource AppBackground}"
>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition /></Grid.RowDefinitions>
    <Border
      Background="{DynamicResource Surface}"
      BorderBrush="{DynamicResource Border}"
      BorderThickness="0,0,0,1"
    >
      <Grid Margin="28,0">
        <TextBlock Text="People" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <ContentControl Grid.Row="1" Content="{Binding Current}" />
  </Grid>
</Window>
