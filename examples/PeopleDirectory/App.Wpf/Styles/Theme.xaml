<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:conv="clr-namespace:PeopleDirectory.Converters"
>
  <conv:AvatarColorConverter x:Key="AvatarColorConverter" />
  <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
  <conv:LoadingItemsSourceConverter x:Key="LoadingItemsSourceConverter" />
  <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

  <SolidColorBrush x:Key="AppBackground" Color="#F5F7FB" />
  <SolidColorBrush x:Key="Surface" Color="White" />
  <SolidColorBrush x:Key="Border" Color="#E2E8F0" />
  <SolidColorBrush x:Key="MutedText" Color="#64748B" />
  <SolidColorBrush x:Key="Accent" Color="#2563EB" />

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="#172033" />
  </Style>
  <Style TargetType="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="#2563EB" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style x:Key="CardButton" TargetType="Button">
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="#172033" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
            x:Name="B"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="12"
            Padding="{TemplateBinding Padding}"
          >
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="B" Property="Background" Value="#EFF6FF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
</ResourceDictionary>
