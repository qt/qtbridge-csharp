<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <QtDotNetPropsImported>true</QtDotNetPropsImported>
    <QtHostIsWindows Condition="'$(OS)' == 'Windows_NT'">true</QtHostIsWindows>
    <QtHostIsWindows Condition="'$(QtHostIsWindows)' == ''">false</QtHostIsWindows>
    <QtHostIsLinux Condition="$([MSBuild]::IsOSPlatform('Linux'))">true</QtHostIsLinux>
    <QtHostIsLinux Condition="'$(QtHostIsLinux)' == ''">false</QtHostIsLinux>
    <QtHostIsMacOS Condition="$([MSBuild]::IsOSPlatform('OSX'))">true</QtHostIsMacOS>
    <QtHostIsMacOS Condition="'$(QtHostIsMacOS)' == ''">false</QtHostIsMacOS>

    <QtDir Condition="'$(QtDir)' == '' and '$(QtInstallRoot)' != '' and Exists('$(QtInstallRoot)/lib/cmake/Qt6/Qt6Config.cmake')"
      >$(QtInstallRoot)</QtDir>

    <QtDotNetSolutionDir Condition="'$(SolutionDir)' != '' AND Exists('$(SolutionDir)qtbridge-csharp.sln')"
      >$(SolutionDir)</QtDotNetSolutionDir>
    <QtDotNetSolutionDir Condition="'$(QtDotNetSolutionDir)' == '' AND Exists('$(MSBuildThisFileDirectory)..\..\qtbridge-csharp.sln')"
      >$(MSBuildThisFileDirectory)..\..\</QtDotNetSolutionDir>

    <QtDotNetGen Condition="'$(QtHostIsWindows)' == 'true'">$(MSBuildThisFileDirectory)qbgen.exe</QtDotNetGen>
    <QtDotNetGen Condition="'$(QtHostIsLinux)' == 'true' OR '$(QtHostIsMacOS)' == 'true'">$(MSBuildThisFileDirectory)qbgen</QtDotNetGen>
    <QtDotNetGen Condition="!Exists('$(QtDotNetGen)') AND '$(QtDotNetSolutionDir)' != '' AND '$(QtHostIsWindows)' == 'true'"
      >$(QtDotNetSolutionDir)src\Qt.Bridge.CSharp.Generator\bin\$(Configuration)\$(TargetFramework)\qbgen.exe</QtDotNetGen>
    <QtDotNetGen Condition="!Exists('$(QtDotNetGen)') AND '$(QtDotNetSolutionDir)' != '' AND ('$(QtHostIsLinux)' == 'true' OR '$(QtHostIsMacOS)' == 'true')"
      >$(QtDotNetSolutionDir)src\Qt.Bridge.CSharp.Generator\bin\$(Configuration)\$(TargetFramework)\qbgen</QtDotNetGen>

    <QtDotNetGenRules>$(MSBuildThisFileDirectory)Qt.Bridge.CSharp.GenerationRules.dll</QtDotNetGenRules>
    <QtDotNetGenRules Condition="!Exists('$(QtDotNetGenRules)') AND '$(QtDotNetSolutionDir)' != ''"
      >$(QtDotNetSolutionDir)src\Qt.Bridge.CSharp.GenerationRules\bin\$(Configuration)\$(TargetFramework)\Qt.Bridge.CSharp.GenerationRules.dll</QtDotNetGenRules>

    <QtDotNetAdapter>$(MSBuildThisFileDirectory)Qt.DotNet.Adapter.dll</QtDotNetAdapter>
    <QtDotNetAdapter Condition="!Exists('$(QtDotNetAdapter)') AND '$(QtDotNetSolutionDir)' != ''"
      >$(QtDotNetSolutionDir)src\Qt.DotNet.Adapter\bin\$(Configuration)\$(TargetFramework)\Qt.DotNet.Adapter.dll</QtDotNetAdapter>

    <QtDotNetLib>$(MSBuildThisFileDirectory)../../include</QtDotNetLib>
    <QtDotNetLib Condition="!Exists('$(QtDotNetLib)/qdotnethost.h') AND '$(QtDotNetSolutionDir)' != ''"
      >$(QtDotNetSolutionDir)include</QtDotNetLib>

    <QtGenCmd>"$(QtDotNetGen)"</QtGenCmd>
    <QtGenCmd>$(QtGenCmd) --ref "$(QtDotNetAdapter)"</QtGenCmd>
    <QtGenCmd>$(QtGenCmd) --rules "$(QtDotNetGenRules)"</QtGenCmd>

    <QtQmlFilesCs>qt/csharp/QmlFiles.cs</QtQmlFilesCs>
    <QtResourceFilesCs>qt/csharp/QtResources.cs</QtResourceFilesCs>
    <QtQmlSourceDir>qt/native/source/qml/</QtQmlSourceDir>
    <QtBridgeAssemblyResourceId Condition="'$(QtBridgeAssemblyResourceId)' == ''"
      >$(AssemblyName)</QtBridgeAssemblyResourceId>
    <QtBridgeExcludeQtResxFromManagedResources
      Condition="'$(QtBridgeExcludeQtResxFromManagedResources)' == ''">true</QtBridgeExcludeQtResxFromManagedResources>

    <QtBuildSystem Condition="'$(QtBuildSystem)' == ''">ninja</QtBuildSystem>
    <QtBuildConfig Condition="'$(QtBuildConfig)' == ''">Release</QtBuildConfig>
  </PropertyGroup>

  <PropertyGroup>
    <QtVsCheckWorkloads Condition="'$(QtHostIsWindows)' == 'true'">true</QtVsCheckWorkloads>
    <QtVsCheckWorkloads Condition="'$(QtVsCheckWorkloads)' == ''">false</QtVsCheckWorkloads>
    <DesktopWorkload>Microsoft.VisualStudio.ComponentGroup.NativeDesktop.Core</DesktopWorkload>

    <QtVsCheckCrossPlat>false</QtVsCheckCrossPlat>
    <CrossPlatformWorkload>Microsoft.VisualStudio.Workload.NativeCrossPlat</CrossPlatformWorkload>

    <ProgramFilesX86 Condition="'$(QtHostIsWindows)' == 'true'">$([MSBuild]::GetProgramFiles32())</ProgramFilesX86>
    <VsWhereExe Condition="'$(QtHostIsWindows)' == 'true'">$(ProgramFilesX86)\Microsoft Visual Studio\Installer\vswhere.exe</VsWhereExe>

  </PropertyGroup>

  <ItemGroup>
    <!-- Add QML files to the build -->
    <Qml Include="**\*.qml" />
    <QtResx Include="**\*.resx" Condition="'$(QtBridgeResourceLibrary)' == 'true'" />
    <!-- Remove copies in output dirs -->
    <Qml Remove="$(BaseOutputPath)**\*.qml" />
    <Qml Remove="$(BaseIntermediateOutputPath)**\*.qml" />
    <QtResx Remove="$(BaseOutputPath)**\*.resx" />
    <QtResx Remove="$(BaseIntermediateOutputPath)**\*.resx" />
    <!-- Add QML files to up-to-date check of VS -->
    <UpToDateCheckInput Set="Qml" Include="@(Qml)" />
    <UpToDateCheckOutput Set="Qml" Include="$(ProjectDir)$(IntermediateOutputPath)$(QtQmlFilesCs)" />
    <UpToDateCheckInput Set="QtResource" Include="@(QtResource);@(QtResx)" />
    <UpToDateCheckOutput Set="QtResource"
      Include="$(ProjectDir)$(IntermediateOutputPath)$(QtResourceFilesCs)" />
    <!-- Add reference to source files for incremental build -->
    <QtDotNetNativeSource
      Include="$(IntermediateOutputPath)qt\native\source\CMakeLists.txt
              ;$(IntermediateOutputPath)qt\native\source\**\*" />
    <!-- Add reference to build files for incremental build -->
    <QtDotNetNativeBuild
      Include="$(IntermediateOutputPath)qt\native\build\CMakeCache.txt
              ;$(IntermediateOutputPath)qt\native\build\**\*" />
  </ItemGroup>

</Project>
