<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <QtPackgeRoot>$(MSBuildThisFileDirectory)..\..\tools\qt</QtPackgeRoot>
    <QtDir Condition="'$(QtDir)' == '' and Exists('$(QtPackgeRoot)\lib\cmake\Qt6\Qt6Config.cmake')"
      >$(QtPackgeRoot)</QtDir>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Qt.Bridge.props"/>
</Project>
