<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <QtPackageRoot>$(MSBuildThisFileDirectory)..\..\tools\qt</QtPackageRoot>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Qt.Bridge.props"/>

  <PropertyGroup>
    <!-- "lib" or the "lib64" multilib layout; see the note in Qt.Bridge.props. -->
    <QtDir Condition="'$(QtDir)' == ''
        and (Exists('$(QtPackageRoot)/lib/cmake/Qt6/Qt6Config.cmake')
          or Exists('$(QtPackageRoot)/lib64/cmake/Qt6/Qt6Config.cmake'))"
      >$(QtPackageRoot)</QtDir>
  </PropertyGroup>
</Project>
