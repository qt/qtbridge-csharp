-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Condition="'$(QtDotNetPropsImported)' != 'true'"
    Project="$(MSBuildThisFileDirectory)Qt.Bridge.props"/>

  <PropertyGroup>
    <QtQmlRootModule Condition="'$(QtQmlRootModule)' == ''">Application</QtQmlRootModule>
    <QtQmlRootModuleName>$([System.Text.RegularExpressions.Regex]::Replace(
      '$(QtQmlRootModule)', '[^\w]', '_'))</QtQmlRootModuleName>
    <QtBridgeAssemblyResourceId Condition="'$(QtBridgeAssemblyResourceId)' == ''"
      >$(MSBuildProjectName)</QtBridgeAssemblyResourceId>
  </PropertyGroup>

  <UsingTask TaskName="QtBridgeResolveResxFileRefs"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ResxFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <ProjectDir ParameterType="System.String" Required="true" />
      <AssemblyResourceId ParameterType="System.String" Required="true" />
      <ResourceAccessOverrides
        ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="false" />
      <ResolvedResources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
      <ManagedEmbeddedResxFiles
        ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Xml.Linq" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Using Namespace="Microsoft.Build.Utilities" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var resolved = new List<ITaskItem>();
        foreach (var resx in ResxFiles ?? Array.Empty<ITaskItem>()) {
            var resxPath = Path.GetFullPath(resx.ItemSpec);
            if (!File.Exists(resxPath)) {
                Log.LogError($"Qt Bridge resource file not found: {resx.ItemSpec}");
                continue;
            }

            var resxDir = Path.GetDirectoryName(resxPath) ?? ProjectDir;
            var document = XDocument.Load(resxPath, LoadOptions.PreserveWhitespace);
            foreach (var data in document.Root?.Elements("data") ?? Enumerable.Empty<XElement>()) {
                var name = (string)data.Attribute("name");
                var value = data.Element("value")?.Value;
                if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(value))
                    continue;

                var fileRef = value.Split(';')[0].Trim();
                if (string.IsNullOrWhiteSpace(fileRef) || Path.GetInvalidPathChars().Any(fileRef.Contains))
                    continue;

                var sourcePath = Path.GetFullPath(Path.Combine(resxDir, fileRef));
                if (!File.Exists(sourcePath))
                    continue;

                var item = new TaskItem(sourcePath);
                item.SetMetadata("SourcePath", sourcePath);
                item.SetMetadata("ResxFile", resxPath);
                item.SetMetadata("Key", $"{Path.GetFileName(resxPath)}::{name}");
                item.SetMetadata("AssemblyId", AssemblyResourceId);
                item.SetMetadata("AccessMode", "Default");

                var projectDirPrefix = Path.GetFullPath(ProjectDir)
                    .TrimEnd(Path.DirectorySeparatorChar) + Path.DirectorySeparatorChar;
                var relativePath = sourcePath.StartsWith(projectDirPrefix, StringComparison.OrdinalIgnoreCase)
                    ? sourcePath.Substring(projectDirPrefix.Length).Replace('\\', '/')
                    : Path.GetFileName(sourcePath);
                item.SetMetadata("Alias", $"assemblies/{AssemblyResourceId}/{relativePath}");
                resolved.Add(item);
            }
        }

        // Apply @(QtResourceAccess) per-entry overrides to resx-sourced entries.
        // Each override's ItemSpec is the key identity (e.g. "Resources.resx::LogoPng").
        // Mode metadata is applied to the matching resolved entry. Reason is optional
        // audit metadata and is copied when present.
        // An unmatched key is a build error: it means the resx no longer has that entry.
        if (ResourceAccessOverrides != null && ResourceAccessOverrides.Length > 0) {
            var resolvedByKey = resolved.ToDictionary(r => r.GetMetadata("Key"), StringComparer.Ordinal);
            foreach (var access in ResourceAccessOverrides) {
                var key = access.ItemSpec;
                if (!resolvedByKey.TryGetValue(key, out var target)) {
                    Log.LogError($"QtResourceAccess '{key}' does not match any resolved resource. "
                        + "The key must match a resolved 'File.resx::ResourceName' entry.");
                    continue;
                }
                var mode = access.GetMetadata("Mode");
                var reason = access.GetMetadata("Reason");
                if (!string.IsNullOrEmpty(mode))
                    target.SetMetadata("AccessMode", mode);
                if (!string.IsNullOrEmpty(reason))
                    target.SetMetadata("Reason", reason);
            }
        }

        ResolvedResources = resolved.ToArray();

        // Unique resx files that need managed embedding: any entry with ManagedAndNative or
        // ManagedOnly requires the whole .resx to be re-added to EmbeddedResource so the
        // managed assembly carries it. The caller does the actual re-include.
        ManagedEmbeddedResxFiles = resolved
            .Where(r => { var m = r.GetMetadata("AccessMode");
                          return string.Equals(m, "ManagedAndNative", StringComparison.OrdinalIgnoreCase)
                              || string.Equals(m, "ManagedOnly",       StringComparison.OrdinalIgnoreCase); })
            .Select(r => r.GetMetadata("ResxFile"))
            .Where(p => !string.IsNullOrEmpty(p))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(p => (ITaskItem)new TaskItem(p))
            .ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeAddResources
  -->
  <Target Name="QtBridgeAddResources" BeforeTargets="CoreCompile"
    Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup Condition="'$(QtBridgeExcludeQtResxFromManagedResources)' == 'true'">
      <EmbeddedResource Remove="@(QtResx)" />
    </ItemGroup>

    <QtBridgeResolveResxFileRefs Condition="'@(QtResx)' != ''"
      ResxFiles="@(QtResx)"
      ProjectDir="$(ProjectDir)"
      AssemblyResourceId="$(QtBridgeAssemblyResourceId)"
      ResourceAccessOverrides="@(QtResourceAccess)">
      <Output TaskParameter="ResolvedResources" ItemName="_QtResolvedResxResource" />
      <Output TaskParameter="ManagedEmbeddedResxFiles" ItemName="_ManagedEmbeddedResxFile" />
    </QtBridgeResolveResxFileRefs>

    <ItemGroup Condition="'$(QtBridgeExcludeQtResxFromManagedResources)' == 'true'">
      <EmbeddedResource Include="@(_ManagedEmbeddedResxFile)" />
    </ItemGroup>

    <ItemGroup>
      <QtResource>
        <SourcePath>%(QtResource.FullPath)</SourcePath>
        <Alias Condition="'%(QtResource.Alias)' == ''">assemblies/$(QtBridgeAssemblyResourceId)/$([System.String]::Copy('%(QtResource.Identity)').Replace('\','/'))</Alias>
        <AssemblyId Condition="'%(QtResource.AssemblyId)' == ''">$(QtBridgeAssemblyResourceId)</AssemblyId>
        <Key Condition="'%(QtResource.Key)' == ''">$([System.String]::Copy('%(QtResource.Identity)').Replace('\','/'))</Key>
        <AccessMode Condition="'%(QtResource.AccessMode)' == ''">Default</AccessMode>
        <Prefix Condition="'%(QtResource.Prefix)' == ''">/</Prefix>
      </QtResource>
      <_QtResolvedResxResource>
        <Prefix Condition="'%(_QtResolvedResxResource.Prefix)' == ''">/</Prefix>
      </_QtResolvedResxResource>
      <_QtResolvedResource Include="@(QtResource);@(_QtResolvedResxResource)" />
    </ItemGroup>

    <Error Condition="'@(_QtResolvedResource)' != ''
        AND '%(_QtResolvedResource.AccessMode)' != 'Default'
        AND '%(_QtResolvedResource.AccessMode)' != 'ManagedAndNative'
        AND '%(_QtResolvedResource.AccessMode)' != 'ManagedOnly'"
      Text="Qt Bridge resource '%(_QtResolvedResource.Identity)' has invalid AccessMode '%(_QtResolvedResource.AccessMode)'. Expected Default, ManagedAndNative, or ManagedOnly." />

    <MakeDir Directories="$(IntermediateOutputPath)qt\csharp" />
    <WriteLinesToFile Overwrite="true"
      WriteOnlyWhenDifferent="true" File="$(ProjectDir)$(IntermediateOutputPath)$(QtResourceFilesCs)"
      Lines="@(_QtResolvedResource->'[assembly: Qt.Bridge.QtResource(
    SourcePath = @&quot;%(SourcePath)&quot;, Alias = &quot;%(Alias)&quot;, Prefix = &quot;%(Prefix)&quot;,
    AssemblyId = &quot;%(AssemblyId)&quot;, Key = &quot;%(Key)&quot;,
    AccessMode = &quot;%(AccessMode)&quot;, Reason = &quot;%(Reason)&quot;)]')" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)qt\csharp\QtResources.cs" />
    </ItemGroup>
  </Target>
  <!-- END QtBridgeAddResources -->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeSetupQml
  -->
  <Target Name="QtBridgeSetupQml">
    <ItemGroup>
      <!-- Set QML file properties -->
      <Qml>
        <IsRoot Condition="'%(RelativeDir)' == ''">true</IsRoot>
        <IsRoot Condition="'%(RelativeDir)' != ''">false</IsRoot>
      </Qml>
      <Qml>
        <SourceDir Condition="%(IsRoot)">$(QtQmlRootModuleName)\</SourceDir>
        <SourceDir Condition="!%(IsRoot)">%(RelativeDir)</SourceDir>
      </Qml>
      <Qml>
        <Uri>$([System.String]::Copy(%(SourceDir))
                .Replace('\','/').Replace('/','.').Trim('.'))</Uri>
        <TypeName>%(FileName)</TypeName>
        <JsonSourcePath>$([System.String]::Copy('$(ProjectDir)%(RelativeDir)%(Filename)%(Extension)').Replace('\', '\\'))</JsonSourcePath>
        <JsonModulePath>$([System.String]::Copy('%(SourceDir)').Replace('\', '\\'))</JsonModulePath>
      </Qml>
    </ItemGroup>
    <ItemGroup>
      <QmlModule Include="@(Qml->Metadata('Uri')->Distinct())" KeepMetadata="IsRoot;SourceDir" />
      <QmlModule Remove="$(QtQmlRootModuleName)" />
      <QmlModule Include="$(QtQmlRootModuleName)">
        <IsRoot>true</IsRoot>
        <SourceDir>$(QtQmlRootModuleName)\</SourceDir>
      </QmlModule>
    </ItemGroup>
  </Target>

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeAddQmlFiles
  -->
  <Target Name="QtBridgeAddQmlFiles" BeforeTargets="CoreCompile" DependsOnTargets="QtBridgeSetupQml"
    Condition="'$(DesignTimeBuild)' != 'true'">
    <!-- Copy QML files to native source dir -->
    <Copy Condition="'@(Qml)' != ''"
      SourceFiles="$(ProjectDir)%(RelativeDir)%(Filename)%(Extension)"
      DestinationFolder="$(IntermediateOutputPath)$(QtQmlSourceDir)%(SourceDir)" />
    <MakeDir Condition="'@(Qml)' != '' OR '@(QmlModule)' != ''"
      Directories="$(IntermediateOutputPath)qt\csharp" />
    <!-- Add C# source with paths of QML files; this will be an input for code generation -->
    <WriteLinesToFile Condition="'@(Qml)' != '' OR '@(QmlModule)' != ''" Overwrite="true"
      WriteOnlyWhenDifferent="false" File="$(ProjectDir)$(IntermediateOutputPath)$(QtQmlFilesCs)"
      Lines="
@(QmlModule->'[assembly: Qt.Quick.QmlModule(
    Uri = &quot;%(Identity)&quot;, IsRoot = %(IsRoot), Path = @&quot;%(SourceDir)&quot;)]');
@(Qml->'[assembly: Qt.Quick.QmlFile(
    Uri = &quot;%(Uri)&quot;, TypeName = &quot;%(TypeName)&quot;, IsRoot = %(IsRoot),
    Path = @&quot;%(SourceDir)%(Filename)%(Extension)&quot;)]');
namespace Qt.Qml
{
    public static class Modules
    {
        public const string Root = &quot;$(QtQmlRootModuleName)&quot;%3B
    }
}
" />
    <ItemGroup>
      <Compile Condition="'@(Qml)' != '' OR '@(QmlModule)' != ''"
        Include="$(IntermediateOutputPath)qt\csharp\QmlFiles.cs" />
    </ItemGroup>
  </Target>
  <!-- END QtBridgeAddQmlFiles -->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtCheckVisualStudioWorkloads
  -->
  <Target Name="QtCheckVisualStudioWorkloads"
          BeforeTargets="QtBridgeGenerate"
          Condition="'$(QtHostIsWindows)' == 'true' and '$(QtVsCheckWorkloads)'=='true'">

    <Warning Condition="!Exists('$(VsWhereExe)')"
             Text="vswhere.exe not found '$(VsWhereExe)'. Ignore workload check." />
    <PropertyGroup Condition="!Exists('$(VsWhereExe)')">
      <SkipWorkloadCheck>true</SkipWorkloadCheck>
    </PropertyGroup>

    <!-- Desktop C++ -->
    <Exec Condition="'$(SkipWorkloadCheck)'!='true'"
          Command="&quot;$(VsWhereExe)&quot; -nologo -latest -products * -format json -requires &quot;$(DesktopWorkload)&quot;"
          StandardOutputImportance="low"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="VsDesktopJson" />
    </Exec>

    <Error Condition="'$(SkipWorkloadCheck)'!='true'
           and ($([System.String]::Copy('$(VsDesktopJson)').Trim()) == ''
           or $([System.String]::Copy('$(VsDesktopJson)').Trim()) == '[]')"
           Text="Missing workload: Desktop development with C++. Please install via the Visual Studio Installer." />

    <!-- Optional: cross-platform C++ -->
    <Exec Condition="'$(SkipWorkloadCheck)'!='true' and '$(QtVsCheckCrossPlat)'=='true'"
          Command="&quot;$(VsWhereExe)&quot; -nologo -products * -format json -requires &quot;$(CrossPlatformWorkload)&quot;"
          StandardOutputImportance="low"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="VsCrossJson" />
    </Exec>

    <Error Condition="'$(SkipWorkloadCheck)'!='true' and '$(QtVsCheckCrossPlat)'=='true'
           and ($([System.String]::Copy('$(VsCrossJson)').Trim()) == ''
           or $([System.String]::Copy('$(VsCrossJson)').Trim()) == '[]')"
           Text="Missing workload: Linux, Mac, and embedded development with C++. Please install via the Visual Studio Installer." />
  </Target>
  <!-- END QtCheckVisualStudioWorkloads -->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeGenerate
  -->
  <Target Name="QtBridgeGenerate" AfterTargets="CoreCompile" BeforeTargets="_CreateAppHost"
    DependsOnTargets="QtBridgeAddQmlFiles;QtBridgeAddResources"
    Condition="'$(DesignTimeBuild)' != 'true'">

    <Message Importance="high" Text="Qt Bridge: Generating native code..." />

    <Error Condition="'$(QtDotNetGen)' == '' OR !Exists('$(QtDotNetGen)')"
      Text="Error: Qt Bridge code generator tool not found" />
    <Error Condition="'$(QtDotNetGenRules)' == '' OR !Exists('$(QtDotNetGenRules)')"
      Text="Error: Qt Bridge code generations rules not found" />
    <Error Condition="'$(QtDotNetAdapter)' == '' OR !Exists('$(QtDotNetAdapter)')"
      Text="Error: Qt/.NET Adapter not found" />
    <Error Condition="'$(QtDotNetLib)' == '' OR !Exists('$(QtDotNetLib)/qdotnethost.h')"
      Text="Error: Qt/.NET C++ Library not found" />

    <PropertyGroup>
      <ProjectIntermediateDir>$(ProjectDir)$(IntermediateOutputPath)</ProjectIntermediateDir>
      <QtGenCmd
        >$(QtGenCmd) --source "$(ProjectIntermediateDir)$(TargetFileName)"</QtGenCmd>
      <QtGenCmd
        >$(QtGenCmd) --target "$(ProjectIntermediateDir)qt\native"</QtGenCmd>
      <QtGenCmd
        >$(QtGenCmd) @(_ResolvedProjectReferencePaths->'--ref &quot;%(Identity)&quot;', ' ')</QtGenCmd>
      <QtGenCmd
        >$(QtGenCmd) @(RuntimeCopyLocalItems->'--ref &quot;%(Identity)&quot;', ' ')</QtGenCmd>
    </PropertyGroup>

    <Message Importance="high" Text="$(QtGenCmd)" />
    <Exec Command="$(QtGenCmd)" EchoOff="true" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="QtGenResult" />
    </Exec>
    <Error Condition="'$(QtGenResult)' != '0'" Text="Error generating native code!" />
    <WriteLinesToFile Overwrite="true" WriteOnlyWhenDifferent="true"
      File="$(IntermediateOutputPath)qt\native\source\qtdotnet.cmake"
      Lines="include_directories(&quot;$(QtDotNetLib.Replace('\', '/'))&quot;)" />
    <ItemGroup>
      <QtDotNetNativeSource Include="$(IntermediateOutputPath)qt\native\source\**\*" />
    </ItemGroup>
  </Target>
  <!-- END QtBridgeGenerate-->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeValidateQt
  -->
  <Target Name="QtBridgeValidateQt" BeforeTargets="QtBridgeBuild"
    Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(QtDir)' == ''"
      Text="Qt Bridge for C# could not find Qt. Set QtDir to a Qt 6 installation prefix containing lib/cmake/Qt6/Qt6Config.cmake. QtInstallRoot is also accepted as a compatibility alias." />
    <Error Condition="'$(QtDir)' != '' AND !Exists('$(QtDir)/lib/cmake/Qt6/Qt6Config.cmake')"
      Text="Qt Bridge for C# could not find Qt at '$(QtDir)'. Set QtDir to a Qt 6 installation prefix containing lib/cmake/Qt6/Qt6Config.cmake." />
  </Target>
  <!-- END QtBridgeValidateQt -->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeBuild
  -->
  <Target Name="QtBridgeBuild"
    DependsOnTargets="QtBridgeGenerate" BeforeTargets="_CreateAppHost"
    Condition="'$(DesignTimeBuild)' != 'true'">

    <Message Importance="high" Text="Qt Bridge: Building native code..." />

    <PropertyGroup>
      <QtNativeBuildDir>$(IntermediateOutputPath)qt/native/build</QtNativeBuildDir>
      <QtNativeSourceDir>$(IntermediateOutputPath)qt/native/source</QtNativeSourceDir>
      <QtNativeBinDir>$(IntermediateOutputPath)qt/native/bin</QtNativeBinDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(QtHostIsWindows)' == 'true' and '$(VsInstallRoot)' == ''">
      <VsWhereCmd>"$(VsWhereExe)"</VsWhereCmd>
      <VsWhereCmd>$(VsWhereCmd) -latest</VsWhereCmd>
      <VsWhereCmd>$(VsWhereCmd) -products *</VsWhereCmd>
      <VsWhereCmd>$(VsWhereCmd) -requires &quot;$(DesktopWorkload)&quot;</VsWhereCmd>
      <VsWhereCmd>$(VsWhereCmd) -property installationPath</VsWhereCmd>
    </PropertyGroup>
    <Exec Condition="'$(QtHostIsWindows)' == 'true' and '$(VsInstallRoot)' == '' and Exists('$(VsWhereExe)')"
          Command="$(VsWhereCmd)" ConsoleToMsBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" ItemName="VsWhereOutput" />
    </Exec>
    <PropertyGroup Condition="'$(QtHostIsWindows)' == 'true' and '$(VsInstallRoot)' == ''">
      <VsInstallRoot Condition="Exists('%(VsWhereOutput.Identity)')">%(VsWhereOutput.Identity)</VsInstallRoot>
    </PropertyGroup>
    <Warning Condition="'$(QtHostIsWindows)' == 'true' and '$(VsInstallRoot)' == '' and '$(QtBuildSystem)' != 'ninja'"
             Text="Visual Studio installation not found; falling back to Ninja generator." />
    <PropertyGroup Condition="'$(QtHostIsWindows)' == 'true' and '$(VsInstallRoot)' != '' and '$(QtBuildSystem)' != 'ninja'">
      <QtCMakeGenerator>Visual Studio 17 2022</QtCMakeGenerator>
    </PropertyGroup>
    <PropertyGroup>
      <QtVcVarsCmd Condition="'$(QtHostIsWindows)' == 'true' and '$(VsInstallRoot)' != '' and Exists('$(VsInstallRoot)\VC\Auxiliary\Build\vcvars64.bat')"
        >CALL "$(VsInstallRoot)\VC\Auxiliary\Build\vcvars64.bat" &gt; NUL &amp;&amp; </QtVcVarsCmd>
      <QtCMakeGenerator Condition="'$(QtCMakeGenerator)' == ''">Ninja</QtCMakeGenerator>
      <QtCMakeExtraArgs Condition="'$(QtCMakeGenerator)' == 'Ninja'">-DCMAKE_BUILD_TYPE=$(QtBuildConfig)</QtCMakeExtraArgs>
    </PropertyGroup>

    <MakeDir Directories="$(QtNativeBuildDir)" />
    <MakeDir Directories="$(QtNativeBinDir)" />

    <PropertyGroup>
      <QtCMakeConfigureCmd Condition="'$(QtHostIsWindows)' == 'true'">$(QtVcVarsCmd)set "CMAKE_PREFIX_PATH=$(QtDir);%CMAKE_PREFIX_PATH%" &amp;&amp; cmake ..\source -DCMAKE_PROJECT_INCLUDE=qtdotnet.cmake -G &quot;$(QtCMakeGenerator)&quot; $(QtCMakeExtraArgs)</QtCMakeConfigureCmd>
      <QtCMakeConfigureCmd Condition="'$(QtHostIsLinux)' == 'true' OR '$(QtHostIsMacOS)' == 'true'">CMAKE_PREFIX_PATH=&quot;$(QtDir):$CMAKE_PREFIX_PATH&quot; cmake ../source -DCMAKE_PROJECT_INCLUDE=qtdotnet.cmake -G &quot;$(QtCMakeGenerator)&quot; $(QtCMakeExtraArgs)</QtCMakeConfigureCmd>
    </PropertyGroup>
    <Exec Command="$(QtCMakeConfigureCmd)" WorkingDirectory="$(QtNativeBuildDir)" EchoOff="true" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="CMakeResult" />
    </Exec>
    <Error Condition="'$(CMakeResult)' != '0'" Text="Error configuring native code!" />

    <PropertyGroup>
      <QtUseMsBuildGenerator Condition="'$(QtHostIsWindows)' == 'true' and '$(QtCMakeGenerator)' != 'Ninja'">true</QtUseMsBuildGenerator>
      <QtUseMsBuildGenerator Condition="'$(QtUseMsBuildGenerator)' == ''">false</QtUseMsBuildGenerator>
    </PropertyGroup>
    <ItemGroup Condition="'$(QtUseMsBuildGenerator)' == 'true'">
      <NativeSln Include="$(QtNativeBuildDir)\*.sln" />
    </ItemGroup>
    <PropertyGroup Condition="'$(QtUseMsBuildGenerator)' == 'true'">
      <NativeApp>%(NativeSln.RelativeDir)%(NativeSln.Filename)</NativeApp>
    </PropertyGroup>
    <ItemGroup Condition="'$(QtUseMsBuildGenerator)' == 'true'">
      <NativeProject Include="$(NativeApp)_tooling.vcxproj;
                              $(NativeApp)_qmlimportscan.vcxproj;
                              $(NativeApp)_autogen.vcxproj;
                              $(NativeApp)_automoc_json_extraction.vcxproj;
                              $(NativeApp).vcxproj" />
      <NativeProject Remove="@(NativeProject)" Condition="!Exists('%(NativeProject.FullPath)')" />
    </ItemGroup>
    <MSBuild Condition="'$(QtUseMsBuildGenerator)' == 'true'"
      Projects="@(NativeProject)" BuildInParallel="false" StopOnFirstFailure="true"
      Properties="Platform=x64;Configuration=$(QtBuildConfig);CL_MP=true" Targets="Build" />
    <Exec Condition="'$(QtUseMsBuildGenerator)' != 'true'"
      Command="$(QtVcVarsCmd)cmake --build . --parallel"
      WorkingDirectory="$(QtNativeBuildDir)" EchoOff="true" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="CMakeResult" />
    </Exec>
    <Error Condition="'$(QtUseMsBuildGenerator)' != 'true' and '$(CMakeResult)' != '0'" Text="Error building native code!" />

    <PropertyGroup>
      <QtNativeHostPath Condition="'$(QtHostIsWindows)' == 'true' and Exists('$(QtNativeBinDir)/$(AssemblyName).exe')">$(QtNativeBinDir)/$(AssemblyName).exe</QtNativeHostPath>
      <QtNativeHostPath Condition="('$(QtHostIsLinux)' == 'true' OR '$(QtHostIsMacOS)' == 'true') and Exists('$(QtNativeBinDir)/$(AssemblyName)')">$(QtNativeBinDir)/$(AssemblyName)</QtNativeHostPath>
    </PropertyGroup>
    <ItemGroup Condition="'$(QtNativeHostPath)' == ''">
      <QtNativeBinary Condition="'$(QtHostIsWindows)' == 'true'" Include="$(QtNativeBinDir)\*.exe" />
      <QtNativeBinary Condition="'$(QtHostIsLinux)' == 'true' OR '$(QtHostIsMacOS)' == 'true'" Include="$(QtNativeBinDir)/*" />
      <QtNativeBinary Remove="@(QtNativeBinary)" Condition="'%(Extension)' == '.so' OR '%(Extension)' == '.dylib' OR '%(Extension)' == '.dll' OR '%(Extension)' == '.a' OR '%(Extension)' == '.json'" />
    </ItemGroup>
    <PropertyGroup>
      <QtNativeHostPath Condition="'$(QtNativeHostPath)' == '' and Exists('%(QtNativeBinary.FullPath)')">%(QtNativeBinary.FullPath)</QtNativeHostPath>
    </PropertyGroup>
    <Error Condition="'$(QtNativeHostPath)' == ''" Text="Error locating native host binary in $(QtNativeBinDir)." />

    <Touch Condition="'$(QtNativeHostPath)' != ''" Files="$(QtNativeHostPath)" />
    <PropertyGroup Condition="'$(QtNativeHostPath)' != ''">
      <AppHostSourcePath>$(QtNativeHostPath)</AppHostSourcePath>
    </PropertyGroup>
  </Target>
  <!-- END QtBridgeBuild-->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeWriteQmlMetadataFile
  //
  // Writes qtbridge-qml.ide.json to obj\[Platform\]Configuration\ so that the
  // Qt Bridge Visual Studio extension can configure and start the QML Language
  // Server without inspecting the full MSBuild graph.
  //
  // Timing: AfterTargets="PrepareForBuild" - runs before C# compilation.
  // All required values are evaluated properties; no compiler outputs are needed.
  // The file is rewritten only when its content changes (WriteOnlyWhenDifferent)
  // to avoid spurious file-watcher churn in the extension.
  -->
  <Target Name="QtBridgeWriteQmlMetadataFile" AfterTargets="PrepareForBuild"
    DependsOnTargets="QtBridgeSetupQml"
    Condition="'$(DesignTimeBuild)' != 'true'">

    <PropertyGroup>
      <!-- Absolute paths to the Qt-native source and build directories. -->
      <_QtIdeSrcDir>$(ProjectDir)$(IntermediateOutputPath)qt\native\source</_QtIdeSrcDir>
      <_QtIdeBldDir>$(ProjectDir)$(IntermediateOutputPath)qt\native\build</_QtIdeBldDir>

      <!--
        Metadata file directory: obj\[Platform\]Configuration\.
        For real platforms (x64, arm64 …), include the platform segment - this matches
        IntermediateOutputPath and what the VS extension resolves via SolutionConfiguration2.
        For Any CPU / AnyCPU / unspecified, use the bare obj\Configuration\ path.
        MSBuild uses 'AnyCPU' (no space) internally; Visual Studio passes 'Any CPU'
        (with space) as the platform name. Both must be treated as unqualified so the
        metadata file is written to obj\Debug\ instead of obj\Any CPU\Debug\, matching the
        plain layout MSBuild produces for AnyCPU and the provider's exact-path lookup.
      -->
      <_QtMetadataFileDir
        Condition="'$(Platform)' == ''
                OR '$(Platform)' == 'AnyCPU'
                OR '$(Platform)' == 'Any CPU'"
        >$(ProjectDir)$(BaseIntermediateOutputPath)$(Configuration)</_QtMetadataFileDir>
      <_QtMetadataFileDir
        Condition="'$(Platform)' != ''
               AND '$(Platform)' != 'AnyCPU'
               AND '$(Platform)' != 'Any CPU'"
        >$(ProjectDir)$(BaseIntermediateOutputPath)$(Platform)\$(Configuration)</_QtMetadataFileDir>

      <!-- JSON-escaped path strings (backslash -> double-backslash). -->
      <_QtIdeJProjFile>$([System.String]::Copy(
        '$(MSBuildProjectFullPath)').Replace('\', '\\'))</_QtIdeJProjFile>
      <_QtIdeJProjDir>$([System.String]::Copy(
        '$(ProjectDir)').Replace('\', '\\'))</_QtIdeJProjDir>
      <_QtIdeJSrcDir>$([System.String]::Copy(
        '$(_QtIdeSrcDir)').Replace('\', '\\'))</_QtIdeJSrcDir>
      <_QtIdeJBldDir>$([System.String]::Copy(
        '$(_QtIdeBldDir)').Replace('\', '\\'))</_QtIdeJBldDir>
      <_QtIdeJModDir>$([System.String]::Copy(
        '$(_QtIdeBldDir)\$(QtQmlRootModuleName)').Replace('\', '\\'))</_QtIdeJModDir>
      <_QtIdeJSourceQmlDir>$([System.String]::Copy(
        '$(_QtIdeSrcDir)\qml').Replace('\', '\\'))</_QtIdeJSourceQmlDir>
      <_QtIdeJQtQmlDir Condition="'$(QtDir)' != ''">$([System.String]::Copy(
        $([System.IO.Path]::GetFullPath('$(QtDir)/qml'))).Replace('\', '\\'))</_QtIdeJQtQmlDir>

      <!--
        importPaths JSON array content (no surrounding brackets).
        Always includes the QML module output directory and the generated source QML
        root for copied QML modules such as QtExampleStyle. Appends the active Qt QML
        directory when $(QtDir) is set,
        suppressing the CI-baked qmlls fallback import path (D:/a/qmlls-workflow/...).
        Written as a compact single-line array in the metadata file.
      -->
      <_QtIdeImportPaths
        Condition="'$(_QtIdeJQtQmlDir)' == ''">"$(_QtIdeJModDir)", "$(_QtIdeJSourceQmlDir)"</_QtIdeImportPaths>
      <_QtIdeImportPaths
        Condition="'$(_QtIdeJQtQmlDir)' != ''">"$(_QtIdeJModDir)", "$(_QtIdeJSourceQmlDir)", "$(_QtIdeJQtQmlDir)"</_QtIdeImportPaths>
    </PropertyGroup>

    <!--
      Create the metadata file directory and both validated directories (sourceDir and
      buildDirs[0]) before writing the metadata file. The extension validates that these
      directories exist on disk before starting the QML Language Server; without this,
      the first watcher notification (fired when the metadata file appears) arrives before
      QtBridgeGenerate/QtBridgeBuild have run, validation fails, and the server never
      starts unless the user manually reopens the QML file after the build completes.
      Empty directories are sufficient - qmlls starts without requiring their contents.
    -->
    <MakeDir Directories="$(_QtMetadataFileDir);$(_QtIdeSrcDir);$(_QtIdeSrcDir)\qml;$(_QtIdeBldDir)" />

    <!--
      Keep the metadata JSON as readable multiline text and let MSBuild expand the
      embedded properties before writing the file. WriteOnlyWhenDifferent prevents
      timestamp changes when nothing has changed, avoiding unnecessary file-watcher
      notifications in the VS extension.
    -->
    <PropertyGroup>
      <_QtMetadataJson><![CDATA[{
  "version": 1,
  "projectFile": "$(_QtIdeJProjFile)",
  "configuration": "$(Configuration)",
  "targetFramework": "$(TargetFramework)",
  "qml": {
    "sourceDir": "$(_QtIdeJSrcDir)",
    "projectSourceDir": "$(_QtIdeJProjDir)",
    "buildDirs": [
      "$(_QtIdeJBldDir)"
    ],
    "importPaths": [$(_QtIdeImportPaths)],
    "files": [
@(Qml->'
      { "sourcePath": "%(JsonSourcePath)",
        "uri": "%(Uri)",
        "typeName": "%(TypeName)",
        "modulePath": "%(JsonModulePath)"
      }', ',
')
    ]
  },
  "qmlLanguageServer": {
    "disableCMakeCalls": true
  }
}]]></_QtMetadataJson>
    </PropertyGroup>
    <WriteLinesToFile Overwrite="true" WriteOnlyWhenDifferent="true"
      File="$(_QtMetadataFileDir)\qtbridge-qml.ide.json"
      Lines="$(_QtMetadataJson)" />

  </Target>
  <!-- END QtBridgeWriteQmlMetadataFile-->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeDeploy
  -->
  <Target Name="QtBridgeDeploy"
    AfterTargets="CopyFilesToOutputDirectory" DependsOnTargets="QtBridgeBuild"
    Condition="'$(DesignTimeBuild)' != 'true'">

    <Message Importance="high" Text="Qt Bridge: Deploying Qt..." />
    <PropertyGroup>
      <QtNativeBuildDir>$(IntermediateOutputPath)qt/native/build</QtNativeBuildDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(QtHostIsWindows)' == 'true' and '$(VsInstallRoot)' == ''">
      <VsWhereCmd>"$(VsWhereExe)"</VsWhereCmd>
      <VsWhereCmd>$(VsWhereCmd) -latest</VsWhereCmd>
      <VsWhereCmd>$(VsWhereCmd) -property installationPath</VsWhereCmd>
    </PropertyGroup>
    <Exec Condition="'$(QtHostIsWindows)' == 'true' and '$(VsInstallRoot)' == '' and Exists('$(VsWhereExe)')"
          Command="$(VsWhereCmd)" ConsoleToMsBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" ItemName="VsWhereOutput" />
    </Exec>
    <PropertyGroup Condition="'$(QtHostIsWindows)' == 'true' and '$(VsInstallRoot)' == ''">
      <VsInstallRoot Condition="Exists('%(VsWhereOutput.Identity)')"
        >%(VsWhereOutput.Identity)</VsInstallRoot>
    </PropertyGroup>

    <PropertyGroup Condition="'$(QtHostIsWindows)' == 'true'">
      <VcVarsCmd Condition="'$(VsInstallRoot)' != ''"
        >CALL "$(VsInstallRoot)\VC\Auxiliary\Build\vcvars64.bat" &gt; NUL</VcVarsCmd>
      <DeployCmd>"$(QtDir)\bin\windeployqt.exe"</DeployCmd>
      <DeployCmd>$(DeployCmd) --qmldir "$(ProjectDir.TrimEnd('\'))"</DeployCmd>
      <DeployCmd>$(DeployCmd) --no-translations --release</DeployCmd>
      <DeployCmd>$(DeployCmd) --no-compiler-runtime</DeployCmd>
      <DeployCmd>$(DeployCmd) "$(RunCommand)"</DeployCmd>
      <DeployCmd>$(DeployCmd) &gt; NUL</DeployCmd>
    </PropertyGroup>
    <Exec Condition="'$(QtHostIsWindows)' == 'true' and Exists('$(QtDir)\bin\windeployqt.exe')"
      Command="
          $(VcVarsCmd)
          $(DeployCmd)"
      WorkingDirectory="$(TargetDir)" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="DeployResult" />
    </Exec>
    <Error Condition="'$(QtHostIsWindows)' == 'true' and Exists('$(QtDir)\bin\windeployqt.exe') and '$(DeployResult)' != '0'" Text="Error deploying Qt binaries!" />
    <Message Condition="'$(QtHostIsLinux)' == 'true' OR '$(QtHostIsMacOS)' == 'true'" Importance="high"
             Text="Qt Bridge: deploying runtime dependencies via CMake install." />
    <Exec Condition="'$(QtHostIsWindows)' == 'true' and Exists('$(QtDir)\bin\windeployqt.exe')" WorkingDirectory="$(TargetDir)" IgnoreExitCode="true"
      Command="$(DeployCmd) --list relative &gt; qtdeploy.txt 2&gt; NUL" />
    <Exec Condition="'$(QtHostIsLinux)' == 'true' OR '$(QtHostIsMacOS)' == 'true'"
          Command="cmake --install . --prefix &quot;$(TargetDir)&quot;"
          WorkingDirectory="$(QtNativeBuildDir)" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="DeployResult" />
    </Exec>
    <Error Condition="('$(QtHostIsLinux)' == 'true' OR '$(QtHostIsMacOS)' == 'true') and '$(DeployResult)' != '0'" Text="Error deploying Qt binaries with CMake install!" />
    <Exec Condition="('$(QtHostIsLinux)' == 'true' OR '$(QtHostIsMacOS)' == 'true') and Exists('$(QtNativeBuildDir)/install_manifest.txt')"
          Command="sed -e &quot;s#^$(TargetDir.Replace('\', '/').TrimEnd('/'))/##&quot; &quot;$(QtNativeBuildDir)/install_manifest.txt&quot; &gt;&gt; &quot;$(TargetDir)qtdeploy.txt&quot;"
          IgnoreExitCode="true" />

    <ItemGroup>
      <QmlDeploy Condition="'@(Qml)' != ''"
        Include="$(ProjectDir)$(IntermediateOutputPath)$(QtQmlSourceDir)%(Qml.SourceDir)*">
        <SourceDir>%(Qml.SourceDir)</SourceDir>
      </QmlDeploy>
    </ItemGroup>
    <Copy Condition="'@(QmlDeploy)' != ''"
      SourceFiles="%(Identity)"
      DestinationFolder="$(TargetDir)%(SourceDir)" />
    <WriteLinesToFile Condition="'@(QmlDeploy)' != ''"
      File="$(TargetDir)qtdeploy.txt" Overwrite="false"
      Lines="%(SourceDir)%(Filename)%(Extension)" />
  </Target>
  <!-- END QtBridgeDeploy-->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeClean
  -->
  <Target Name="QtBridgeClean" AfterTargets="Clean">
    <RemoveDir Directories="$(IntermediateOutputPath)qt" />
    <ReadLinesFromFile Condition="Exists('$(TargetDir)qtdeploy.txt')"
      File="$(TargetDir)qtdeploy.txt">
      <Output TaskParameter="Lines" ItemName="QtDeploy"/>
    </ReadLinesFromFile>
    <Delete Files="@(QtDeploy->'$(TargetDir)%(Identity)')" />
    <Delete Files="$(TargetDir)qtdeploy.txt" />
    <RemoveDir Condition="$([System.String]::Copy('%(QtDeploy.Identity)').Contains('\')) OR
                        $([System.String]::Copy('%(QtDeploy.Identity)').Contains('/'))"
       Directories="$(TargetDir)$([System.IO.Path]::GetDirectoryName(%(QtDeploy.Identity)).Replace('\', '/').Split('/')[0])" />
  </Target>
  <!-- END QtBridgeClean-->

</Project>
