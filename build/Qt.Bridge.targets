<?xml version="1.0" encoding="utf-8"?>
<!--
// Copyright (C) 2026 The Qt Company Ltd.
// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Condition="'$(QtDotNetPropsImported)' != 'true'"
    Project="$(MSBuildThisFileDirectory)Qt.Bridge.props"/>

  <PropertyGroup>
    <QtQmlRootModule Condition="'$(QtQmlRootModule)' == ''">Application</QtQmlRootModule>
    <QtQmlRootModuleName>$([System.Text.RegularExpressions.Regex]::Replace(
      '$(QtQmlRootModule)', '[^\w]', '_'))</QtQmlRootModuleName>
    <QtBridgeAssemblyResourceId Condition="'$(QtBridgeAssemblyResourceId)' == ''"
      >$(MSBuildProjectName)</QtBridgeAssemblyResourceId>
    <QtNativeBuildDir Condition="'$(_QtNativeBuildDirIsDefault)' == 'true'"
      >$([System.String]::Copy('$(IntermediateOutputPath)').Replace('\','/'))qt/native/build</QtNativeBuildDir>
    <QtNativeSourceDir Condition="'$(_QtNativeSourceDirIsDefault)' == 'true'"
      >$([System.String]::Copy('$(IntermediateOutputPath)').Replace('\','/'))qt/native/source</QtNativeSourceDir>
    <QtNativeBinDir Condition="'$(_QtNativeBinDirIsDefault)' == 'true'"
      >$([System.String]::Copy('$(IntermediateOutputPath)').Replace('\','/'))qt/native/bin</QtNativeBinDir>
    <!--
      NuGet imports package .props before the consuming project body and package .targets after it.
      Resolve intermediate paths here so project-level overrides have already been evaluated.
    -->
    <_QtProjectIntermediateDir Condition="'$(IntermediateOutputPath)' != ''"
      >$([MSBuild]::NormalizePath('$(ProjectDir)', '$(IntermediateOutputPath)'))</_QtProjectIntermediateDir>
    <_QtProjectBaseIntermediateDir Condition="'$(BaseIntermediateOutputPath)' != ''"
      >$([MSBuild]::NormalizePath('$(ProjectDir)', '$(BaseIntermediateOutputPath)'))</_QtProjectBaseIntermediateDir>
    <_QtProjectNativeBuildDir
      >$([MSBuild]::NormalizePath('$(ProjectDir)', '$(QtNativeBuildDir)'))</_QtProjectNativeBuildDir>
    <_QtProjectNativeSourceDir
      >$([MSBuild]::NormalizePath('$(ProjectDir)', '$(QtNativeSourceDir)'))</_QtProjectNativeSourceDir>
    <_QtProjectNativeBinDir
      >$([MSBuild]::NormalizePath('$(ProjectDir)', '$(QtNativeBinDir)'))</_QtProjectNativeBinDir>
    <QtBridgeBuildTasks Condition="'$(QtBridgeBuildTasks)' == ''"
      >$(MSBuildThisFileDirectory)Qt.Bridge.CSharp.Build.Tasks.dll</QtBridgeBuildTasks>
    <QtBridgeBuildTasks Condition="!Exists('$(QtBridgeBuildTasks)') AND '$(QtDotNetSolutionDir)' != ''"
      >$(QtDotNetSolutionDir)src/Qt.Bridge.CSharp.Build.Tasks/bin/$(Configuration)/netstandard2.0/Qt.Bridge.CSharp.Build.Tasks.dll</QtBridgeBuildTasks>
    <_QtQmlSourceDir>$(QtNativeSourceDir)/qml/</_QtQmlSourceDir>
  </PropertyGroup>

  <UsingTask
    TaskName="Qt.Bridge.CSharp.Build.Tasks.PrepareQmlBuildMetadata"
    AssemblyFile="$(QtBridgeBuildTasks)"
    TaskFactory="TaskHostFactory" />

  <UsingTask TaskName="QtBridgeResolveResxFileRefs"
    AssemblyFile="$(QtBridgeBuildTasks)"
    TaskFactory="TaskHostFactory" />

  <UsingTask TaskName="Qt.Bridge.CSharp.Build.Tasks.PatchNativeHostManifest"
    AssemblyFile="$(QtBridgeBuildTasks)"
    TaskFactory="TaskHostFactory" />

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeAddResources
  -->
  <Target Name="QtBridgeAddResources" BeforeTargets="CoreCompile"
    Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup Condition="'$(QtBridgeExcludeQtResxFromManagedResources)' == 'true'">
      <EmbeddedResource Remove="@(QtResx)" />
    </ItemGroup>

    <QtBridgeResolveResxFileRefs Condition="'@(QtResx)' != ''"
      ResxFiles="@(QtResx)"
      ProjectDir="$(ProjectDir)"
      AssemblyResourceId="$(QtBridgeAssemblyResourceId)"
      ResourceAccessOverrides="@(QtResourceAccess)">
      <Output TaskParameter="ResolvedResources" ItemName="_QtResolvedResxResource" />
      <Output TaskParameter="ManagedEmbeddedResxFiles" ItemName="_ManagedEmbeddedResxFile" />
    </QtBridgeResolveResxFileRefs>

    <ItemGroup Condition="'$(QtBridgeExcludeQtResxFromManagedResources)' == 'true'">
      <EmbeddedResource Include="@(_ManagedEmbeddedResxFile)" />
    </ItemGroup>

    <ItemGroup>
      <QtResource>
        <SourcePath>%(QtResource.FullPath)</SourcePath>
        <Alias Condition="'%(QtResource.Alias)' != ''">$([System.String]::Copy('%(QtResource.Alias)').Replace('\','/'))</Alias>
        <Alias Condition="'%(QtResource.Alias)' == ''">assemblies/$(QtBridgeAssemblyResourceId)/$([System.String]::Copy('%(QtResource.Identity)').Replace('\','/'))</Alias>
        <AssemblyId Condition="'%(QtResource.AssemblyId)' == ''">$(QtBridgeAssemblyResourceId)</AssemblyId>
        <Key Condition="'%(QtResource.Key)' == ''">$([System.String]::Copy('%(QtResource.Identity)').Replace('\','/'))</Key>
        <AccessMode Condition="'%(QtResource.AccessMode)' == ''">Default</AccessMode>
        <Prefix Condition="'%(QtResource.Prefix)' == ''">/</Prefix>
      </QtResource>
      <_QtResolvedResxResource>
        <Prefix Condition="'%(_QtResolvedResxResource.Prefix)' == ''">/</Prefix>
      </_QtResolvedResxResource>
      <_QtResolvedResource Include="@(QtResource);@(_QtResolvedResxResource)" />
    </ItemGroup>

    <Error Condition="'@(_QtResolvedResource)' != ''
        AND '%(_QtResolvedResource.AccessMode)' != 'Default'
        AND '%(_QtResolvedResource.AccessMode)' != 'ManagedAndNative'
        AND '%(_QtResolvedResource.AccessMode)' != 'ManagedOnly'"
      Text="Qt Bridge resource '%(_QtResolvedResource.Identity)' has invalid AccessMode '%(_QtResolvedResource.AccessMode)'. Expected Default, ManagedAndNative, or ManagedOnly." />

    <MakeDir Directories="$(IntermediateOutputPath)qt/csharp" />
    <WriteLinesToFile Overwrite="true"
      WriteOnlyWhenDifferent="true" File="$(_QtProjectIntermediateDir)/$(QtResourceFilesCs)"
      Lines="@(_QtResolvedResource->'[assembly: Qt.Bridge.QtResource(
    SourcePath = @&quot;%(SourcePath)&quot;, Alias = &quot;%(Alias)&quot;, Prefix = &quot;%(Prefix)&quot;,
    AssemblyId = &quot;%(AssemblyId)&quot;, Key = &quot;%(Key)&quot;,
    AccessMode = &quot;%(AccessMode)&quot;, Reason = &quot;%(Reason)&quot;)]')" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)$(QtResourceFilesCs)" />
    </ItemGroup>
  </Target>
  <!-- END QtBridgeAddResources -->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeSetupQml
  -->
  <Target Name="QtBridgeSetupQml">
    <ItemGroup>
      <!-- Set QML file properties -->
      <Qml>
        <IsRoot Condition="'%(RelativeDir)' == ''">true</IsRoot>
        <IsRoot Condition="'%(RelativeDir)' != ''">false</IsRoot>
      </Qml>
      <Qml>
        <SourceDir Condition="%(IsRoot)">$(QtQmlRootModuleName)/</SourceDir>
        <SourceDir Condition="!%(IsRoot)">%(RelativeDir)</SourceDir>
      </Qml>
      <Qml>
        <Uri>$([System.String]::Copy(%(SourceDir))
                .Replace('\','/').Replace('/','.').Trim('.'))</Uri>
        <TypeName>%(FileName)</TypeName>
        <JsonSourcePath>$([System.String]::Copy('$(ProjectDir)%(RelativeDir)%(Filename)%(Extension)').Replace('\', '/'))</JsonSourcePath>
        <JsonModulePath>$([System.String]::Copy('%(SourceDir)').Replace('\', '/'))</JsonModulePath>
        <JsonResourceUrl>$([System.String]::Copy('qrc:/qt/qml/%(SourceDir)%(Filename)%(Extension)').Replace('\', '/'))</JsonResourceUrl>
      </Qml>
    </ItemGroup>
    <ItemGroup>
      <QmlModule Include="@(Qml->Metadata('Uri')->Distinct())" KeepMetadata="IsRoot;SourceDir" />
      <QmlModule Remove="$(QtQmlRootModuleName)" />
      <QmlModule Include="$(QtQmlRootModuleName)">
        <IsRoot>true</IsRoot>
        <SourceDir>$(QtQmlRootModuleName)/</SourceDir>
      </QmlModule>
    </ItemGroup>
  </Target>

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeAddQmlFiles
  -->
  <Target Name="QtBridgeAddQmlFiles" BeforeTargets="CoreCompile" DependsOnTargets="QtBridgeSetupQml"
    Condition="'$(DesignTimeBuild)' != 'true'">
    <!-- The staging directory belongs entirely to this target, so rebuild it from the current items. -->
    <RemoveDir Directories="$(_QtQmlSourceDir)" />
    <Copy Condition="'@(Qml)' != ''"
      SourceFiles="$(ProjectDir)%(RelativeDir)%(Filename)%(Extension)"
      DestinationFolder="$(_QtQmlSourceDir)%(SourceDir)" />
    <MakeDir Condition="'@(Qml)' != '' OR '@(QmlModule)' != ''"
      Directories="$(IntermediateOutputPath)qt/csharp" />
    <!-- Add C# source with paths of QML files; this will be an input for code generation -->
    <WriteLinesToFile Condition="'@(Qml)' != '' OR '@(QmlModule)' != ''" Overwrite="true"
      WriteOnlyWhenDifferent="false" File="$(_QtProjectIntermediateDir)/$(QtQmlFilesCs)"
      Lines="
@(QmlModule->'[assembly: Qt.Quick.QmlModule(
    Uri = &quot;%(Identity)&quot;, IsRoot = %(IsRoot), Path = @&quot;%(SourceDir)&quot;)]');
@(Qml->'[assembly: Qt.Quick.QmlFile(
    Uri = &quot;%(Uri)&quot;, TypeName = &quot;%(TypeName)&quot;, IsRoot = %(IsRoot),
    Path = @&quot;%(SourceDir)%(Filename)%(Extension)&quot;)]');
namespace Qt.Qml
{
    public static class Modules
    {
        public const string Root = &quot;$(QtQmlRootModuleName)&quot;%3B
    }
}
" />
    <ItemGroup>
      <Compile Condition="'@(Qml)' != '' OR '@(QmlModule)' != ''"
        Include="$(IntermediateOutputPath)$(QtQmlFilesCs)" />
    </ItemGroup>
  </Target>
  <!-- END QtBridgeAddQmlFiles -->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtCheckVisualStudioWorkloads
  -->
  <Target Name="QtCheckVisualStudioWorkloads"
          AfterTargets="QtBridgeGenerate" BeforeTargets="QtBridgeBuild"
          Condition="'$(QtHostIsWindows)' == 'true' and '$(QtVsCheckWorkloads)'=='true'
            AND '$(QtGenSourceCode)' == 'true'">

    <Warning Condition="!Exists('$(VsWhereExe)')"
             Text="vswhere.exe not found '$(VsWhereExe)'. Ignore workload check." />
    <PropertyGroup Condition="!Exists('$(VsWhereExe)')">
      <SkipWorkloadCheck>true</SkipWorkloadCheck>
    </PropertyGroup>

    <!-- Desktop C++ -->
    <Exec Condition="'$(SkipWorkloadCheck)'!='true'"
          Command="&quot;$(VsWhereExe)&quot; -nologo -latest -products * -format json -requires &quot;$(DesktopWorkload)&quot;"
          StandardOutputImportance="low"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="VsDesktopJson" />
    </Exec>

    <Error Condition="'$(SkipWorkloadCheck)'!='true'
           and ($([System.String]::Copy('$(VsDesktopJson)').Trim()) == ''
           or $([System.String]::Copy('$(VsDesktopJson)').Trim()) == '[]')"
           Text="Missing workload: Desktop development with C++. Please install via the Visual Studio Installer." />

    <!-- Optional: cross-platform C++ -->
    <Exec Condition="'$(SkipWorkloadCheck)'!='true' and '$(QtVsCheckCrossPlat)'=='true'"
          Command="&quot;$(VsWhereExe)&quot; -nologo -products * -format json -requires &quot;$(CrossPlatformWorkload)&quot;"
          StandardOutputImportance="low"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="VsCrossJson" />
    </Exec>

    <Error Condition="'$(SkipWorkloadCheck)'!='true' and '$(QtVsCheckCrossPlat)'=='true'
           and ($([System.String]::Copy('$(VsCrossJson)').Trim()) == ''
           or $([System.String]::Copy('$(VsCrossJson)').Trim()) == '[]')"
           Text="Missing workload: Linux, Mac, and embedded development with C++. Please install via the Visual Studio Installer." />
  </Target>
  <!-- END QtCheckVisualStudioWorkloads -->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeGenerate
  -->
  <Target Name="QtBridgeGenerate" AfterTargets="CoreCompile" BeforeTargets="_CreateAppHost"
    DependsOnTargets="QtBridgeAddQmlFiles;QtBridgeAddResources"
    Condition="'$(DesignTimeBuild)' != 'true'">

    <Message Importance="high" Text="Qt Bridge: Generating native code..." />

    <ItemGroup>
      <QtGenRules>
        <Dll>$(MSBuildThisFileDirectory)%(Identity).dll</Dll>
      </QtGenRules>
      <QtGenRules>
        <Dll Condition="!Exists('%(Dll)') AND '$(QtDotNetSolutionDir)' != ''">$(QtDotNetSolutionDir)src/%(Identity)/bin/$(Configuration)/$(TargetFramework)/%(Identity).dll</Dll>
      </QtGenRules>
    </ItemGroup>

    <Error Condition="'$(QtDotNetGenAssembly)' == '' OR !Exists('$(QtDotNetGenAssembly)')"
      Text="Error: Qt Bridge code generator tool not found" />
    <Error Condition="!Exists('%(QtGenRules.Dll)')"
      Text="Error: Qt Bridge code generation rules not found: %(QtGenRules.Identity)" />
    <Error Condition="'$(QtDotNetAdapter)' == '' OR !Exists('$(QtDotNetAdapter)')"
      Text="Error: Qt/.NET Adapter not found" />
    <Error Condition="'$(QtDotNetLib)' == '' OR !Exists('$(QtDotNetLib)/qdotnethost.h')"
      Text="Error: Qt/.NET C++ Library not found" />

    <PropertyGroup>
      <ProjectIntermediateDir>$(_QtProjectIntermediateDir)/</ProjectIntermediateDir>
      <ProjectQtNativeSourceDir>$(_QtProjectNativeSourceDir)</ProjectQtNativeSourceDir>
      <ProjectQtNativeRootDir
        >$([System.IO.Path]::GetFullPath('$(ProjectQtNativeSourceDir)/..'))</ProjectQtNativeRootDir>
      <QtGenCmd
        >$(QtGenCmd) --source "$(ProjectIntermediateDir)$(TargetFileName)"</QtGenCmd>
      <QtGenCmd
        >$(QtGenCmd) --target "$(ProjectQtNativeRootDir)"</QtGenCmd>
      <QtGenCmd>$(QtGenCmd) --resource-packaging "$(QtResourcePackaging)"</QtGenCmd>
      <QtGenCmd Condition="'$(QtExportAs)' != ''"
        >$(QtGenCmd) --export-as "$(QtExportAs)"</QtGenCmd>
      <QtGenCmd
        >$(QtGenCmd) --metadata-file-name "$(QtBridgeMetadataFileName)"</QtGenCmd>
      <QtGenCmd
        >$(QtGenCmd) @(_ResolvedProjectReferencePaths->'--ref &quot;%(Identity)&quot;', ' ')</QtGenCmd>
      <QtGenCmd
        >$(QtGenCmd) @(RuntimeCopyLocalItems->'--ref &quot;%(Identity)&quot;', ' ')</QtGenCmd>
      <QtGenCmd
        >$(QtGenCmd) @(QtGenRules->'--rules "%(Dll)"', ' ')</QtGenCmd>
    </PropertyGroup>

    <Message Importance="high" Text="$(QtGenCmd)" />
    <Exec Command="$(QtGenCmd)" EchoOff="true" IgnoreExitCode="true"
          CustomErrorRegularExpression="^Qt Bridge: ERROR:">
      <Output TaskParameter="ExitCode" PropertyName="QtGenResult" />
    </Exec>
    <Error Condition="'$(QtGenResult)' != '0'" Text="Error generating native code!" />

    <PropertyGroup>
      <QtGenSourceCode>$([System.IO.File]::Exists($([System.IO.Path]::Combine(
        "$(ProjectQtNativeRootDir)", "source_code_status.txt"))))</QtGenSourceCode>
    </PropertyGroup>

    <ItemGroup>
      <QtDotnetCMake
        Include="include_directories(&quot;$(QtDotNetLib.Replace('\', '/'))&quot;)" />
      <QtDotnetCMake Condition="'$(QtDotNetProfiler)' == 'enable'"
        Include="add_compile_definitions(ENABLE_QDOTNETPROFILER)" />
      <QtDotnetCMake Condition="'$(QtDotNetSafeMethod)' == 'disable'"
        Include="add_compile_definitions(DISABLE_QDOTNETSAFEMETHOD)" />
    </ItemGroup>

    <WriteLinesToFile Condition="'$(QtGenSourceCode)' == 'true'"
      Overwrite="true" WriteOnlyWhenDifferent="true"
      File="$(QtNativeSourceDir)/qtdotnet.cmake"
      Lines="@(QtDotnetCMake)" />

    <ItemGroup Condition="'$(QtGenSourceCode)' == 'true'">
      <QtDotNetNativeSource Include="$(QtNativeSourceDir)/**/*" />
    </ItemGroup>

    <PropertyGroup Condition="'$(QtGenSourceCode)' != 'true' AND '$(QtAppHost)' != ''">
      <AppHostSourcePath>$(QtAppHost)</AppHostSourcePath>
    </PropertyGroup>

    <!--
      The generator omits the type metadata file when every type is registered from
      generated C++. Remove a possible earlier metadata file to avoid leaving behind
      a stale $(QtBridgeMetadataFileName) in the output directory.
    -->
    <PropertyGroup>
      <QtBridgeGeneratedMetadata
        >$(ProjectQtNativeRootDir)/$(QtBridgeMetadataFileName)</QtBridgeGeneratedMetadata>
      <QtBridgeDeployedMetadata
        >$(TargetDir)$(QtBridgeMetadataFileName)</QtBridgeDeployedMetadata>
    </PropertyGroup>
    <Copy Condition="Exists('$(QtBridgeGeneratedMetadata)')"
      SourceFiles="$(QtBridgeGeneratedMetadata)"
      DestinationFiles="$(QtBridgeDeployedMetadata)" />
    <Delete Condition="!Exists('$(QtBridgeGeneratedMetadata)')" Files="$(QtBridgeDeployedMetadata)" />

  </Target>
  <!-- END QtBridgeGenerate-->

  <!-- Resource packaging runs after generation even when no native build is required. -->
  <Target Name="QtBridgePackageResources" AfterTargets="QtBridgeGenerate"
    DependsOnTargets="QtBridgeResolveResourcePack;QtBridgeCompileResourcePack;QtBridgeDeployResourcePack"
    Condition="'$(DesignTimeBuild)' != 'true'" />

  <Target Name="QtBridgeResolveResourcePack" DependsOnTargets="QtBridgeResolveQtLayout">
    <PropertyGroup>
      <_QtResourceQrc>$(ProjectQtNativeRootDir)/qt_bridge_resources.qrc</_QtResourceQrc>
      <!-- Keep the binary under build/, which generator cleanup preserves. -->
      <_QtResourcePack>$(_QtProjectNativeBuildDir)/$(QtBridgeResourcePackFileName)</_QtResourcePack>
      <_QtDeployedResourcePack>$(TargetDir)$(QtBridgeResourcePackFileName)</_QtDeployedResourcePack>
      <QtRccExecutable Condition="'$(QtRccExecutable)' == '' AND '$(QtHostIsWindows)' == 'true'"
        >$(QtDir)/bin/rcc.exe</QtRccExecutable>
      <!--
        Qt installer: <prefix>/libexec/rcc. Distribution packages keep the Qt 6 host tools in a
        qt6 subdirectory: <libdir>/qt6/libexec (Fedora, openSUSE), lib/qt6/libexec (Debian,
        Ubuntu) or lib/qt6 (Arch Linux). These are checked before <prefix>/bin/rcc, which on a
        distribution prefix such as /usr may be the Qt 5 resource compiler.
      -->
      <QtRccExecutable Condition="'$(QtRccExecutable)' == '' AND Exists('$(QtDir)/libexec/rcc')"
        >$(QtDir)/libexec/rcc</QtRccExecutable>
      <QtRccExecutable Condition="'$(QtRccExecutable)' == '' AND '$(QtLibDir)' != ''
          AND Exists('$(QtLibDir)/qt6/libexec/rcc')">$(QtLibDir)/qt6/libexec/rcc</QtRccExecutable>
      <QtRccExecutable Condition="'$(QtRccExecutable)' == '' AND Exists('$(QtDir)/lib/qt6/libexec/rcc')"
        >$(QtDir)/lib/qt6/libexec/rcc</QtRccExecutable>
      <QtRccExecutable Condition="'$(QtRccExecutable)' == '' AND Exists('$(QtDir)/lib/qt6/rcc')"
        >$(QtDir)/lib/qt6/rcc</QtRccExecutable>
      <QtRccExecutable Condition="'$(QtRccExecutable)' == ''">$(QtDir)/bin/rcc</QtRccExecutable>
    </PropertyGroup>
    <ItemGroup>
      <_QtResourcePackInput Remove="@(_QtResourcePackInput)" />
    </ItemGroup>
    <XmlPeek Condition="Exists('$(_QtResourceQrc)')" XmlInputPath="$(_QtResourceQrc)"
      Query="/RCC/qresource/file/text()">
      <Output TaskParameter="Result" ItemName="_QtResourcePackInput" />
    </XmlPeek>
    <Error Condition="Exists('$(_QtResourceQrc)') AND !Exists('$(QtRccExecutable)')"
      Text="Qt resource compiler not found: '$(QtRccExecutable)'. Set QtDir or QtRccExecutable to a host-compatible rcc." />
    <Delete Condition="!Exists('$(_QtResourceQrc)')"
      Files="$(_QtResourcePack);$(_QtDeployedResourcePack)" />
    <ItemGroup Condition="Exists('$(_QtResourceQrc)')">
      <FileWrites Include="$(_QtResourcePack);$(_QtDeployedResourcePack)" />
    </ItemGroup>
  </Target>

  <Target Name="QtBridgeCompileResourcePack" Condition="Exists('$(_QtResourceQrc)')"
    Inputs="$(_QtResourceQrc);@(_QtResourcePackInput);$(QtRccExecutable)"
    Outputs="$(_QtResourcePack)">
    <MakeDir Directories="$(_QtProjectNativeBuildDir)" />
    <Exec Command="&quot;$(QtRccExecutable)&quot; --binary --output &quot;$(_QtResourcePack)&quot; &quot;$(_QtResourceQrc)&quot;" />
  </Target>

  <Target Name="QtBridgeDeployResourcePack" Condition="Exists('$(_QtResourceQrc)')">
    <Copy SourceFiles="$(_QtResourcePack)" DestinationFiles="$(_QtDeployedResourcePack)"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="QtBridgePublishResourcePack" AfterTargets="ComputeFilesToPublish"
    Condition="'$(DesignTimeBuild)' != 'true' AND Exists('$(TargetDir)$(QtBridgeResourcePackFileName)')">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(QtBridgeResourcePackFileName)">
        <RelativePath>$(QtBridgeResourcePackFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeResolveQtLayout
  //
  // Locates the Qt CMake package files and the QML directory under $(QtDir):
  //   lib/cmake                     Qt installer, Arch Linux, macOS
  //   lib64/cmake                   Fedora, openSUSE
  //   lib/<multiarch>/cmake         Debian, Ubuntu
  // QtLibDirName is derived from the layout found on disk, so any value passed in from outside
  // is overwritten. Distribution packages keep the QML modules under <libdir>/qt6/qml instead of
  // <prefix>/qml.
  -->
  <Target Name="QtBridgeResolveQtLayout">
    <PropertyGroup>
      <QtLibDirName></QtLibDirName>
      <QtLibDir></QtLibDir>
      <QtLibDirName Condition="'$(QtDir)' != '' AND Exists('$(QtDir)/lib/cmake/Qt6/Qt6Config.cmake')"
        >lib</QtLibDirName>
      <QtLibDirName Condition="'$(QtLibDirName)' == '' AND '$(QtDir)' != ''
          AND Exists('$(QtDir)/lib64/cmake/Qt6/Qt6Config.cmake')"
        >lib64</QtLibDirName>
      <QtLibDirName Condition="'$(QtLibDirName)' == '' AND '$(QtDir)' != '' AND '$(QtLinuxMultiarch)' != ''
          AND Exists('$(QtDir)/lib/$(QtLinuxMultiarch)/cmake/Qt6/Qt6Config.cmake')"
        >lib/$(QtLinuxMultiarch)</QtLibDirName>
      <QtLibDir Condition="'$(QtLibDirName)' != ''">$(QtDir)/$(QtLibDirName)</QtLibDir>

      <QtQmlDir Condition="'$(QtQmlDir)' == '' AND '$(QtDir)' != '' AND Exists('$(QtDir)/qml')"
        >$(QtDir)/qml</QtQmlDir>
      <QtQmlDir Condition="'$(QtQmlDir)' == '' AND '$(QtLibDir)' != '' AND Exists('$(QtLibDir)/qt6/qml')"
        >$(QtLibDir)/qt6/qml</QtQmlDir>
      <QtQmlDir Condition="'$(QtQmlDir)' == '' AND '$(QtDir)' != ''">$(QtDir)/qml</QtQmlDir>
    </PropertyGroup>
  </Target>
  <!-- END QtBridgeResolveQtLayout -->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeValidateQt
  -->
  <Target Name="QtBridgeValidateQt" BeforeTargets="QtBridgeBuild"
    DependsOnTargets="QtBridgeResolveQtLayout"
    Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(QtDir)' == ''"
      Text="Qt Bridge for C# could not find Qt. Set QtDir to a Qt 6 installation prefix containing lib/cmake/Qt6/Qt6Config.cmake, lib64/cmake/Qt6/Qt6Config.cmake, or lib/&lt;multiarch triplet&gt;/cmake/Qt6/Qt6Config.cmake. QtInstallRoot is also accepted as a compatibility alias." />
    <Error Condition="'$(QtDir)' != '' AND '$(QtLibDirName)' == ''"
      Text="Qt Bridge for C# could not find Qt at '$(QtDir)'. Set QtDir to a Qt 6 installation prefix containing lib/cmake/Qt6/Qt6Config.cmake, lib64/cmake/Qt6/Qt6Config.cmake, or lib/&lt;multiarch triplet&gt;/cmake/Qt6/Qt6Config.cmake." />

    <PropertyGroup>
      <_QtBridgeUsesPackageQt>false</_QtBridgeUsesPackageQt>
      <_QtBridgeUsesPackageQt Condition="'$(QtPackageRoot)' != '' AND
        '$([MSBuild]::NormalizeDirectory($(QtDir)))' == '$([MSBuild]::NormalizeDirectory($(QtPackageRoot)))'"
        >true</_QtBridgeUsesPackageQt>
    </PropertyGroup>
    <Message Importance="high" Condition="'$(_QtBridgeUsesPackageQt)' != 'true'"
      Text="Qt Bridge for C#: Using Qt at '$(QtDir)'. Set QtDir to use a different Qt installation." />
    <Message Importance="high" Condition="'$(_QtBridgeUsesPackageQt)' == 'true'"
      Text="Qt Bridge for C#: Using the Qt bundled with the NuGet package. Set QtDir to use a different Qt installation." />
  </Target>
  <!-- END QtBridgeValidateQt -->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeInvalidateQmlBuildMetadata
  -->
  <Target Name="QtBridgeInvalidateQmlBuildMetadata"
    BeforeTargets="QtBridgeValidateQt;QtBridgeBuild"
    Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_QtBuildReadyMarker
        >$(_QtProjectNativeBuildDir)/.qt/qtbridge-build.ready</_QtBuildReadyMarker>
    </PropertyGroup>
    <Delete Files="$(_QtBuildReadyMarker)" />
  </Target>
  <!-- END QtBridgeInvalidateQmlBuildMetadata -->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeBuild
  -->
  <Target Name="QtBridgeBuild"
    DependsOnTargets="QtBridgeGenerate" BeforeTargets="_CreateAppHost"
    Condition="'$(DesignTimeBuild)' != 'true' AND '$(QtGenSourceCode)' == 'true'">

    <Message Importance="high" Text="Qt Bridge: Building native code..." />

    <!-- The reason the build entered the native path, as recorded by the generator. -->
    <PropertyGroup>
      <_QtNl>$([System.Environment]::NewLine)</_QtNl>
      <QtNativeBuildReason></QtNativeBuildReason>
      <QtNativeBuildReason Condition="Exists('$(ProjectQtNativeRootDir)/native_build_reason.txt')"
        >$([System.IO.File]::ReadAllText('$(ProjectQtNativeRootDir)/native_build_reason.txt'))</QtNativeBuildReason>
      <QtNativeBuildReason>$(QtNativeBuildReason.TrimEnd())</QtNativeBuildReason>
      <!-- Stale intermediates can leave source_code_status.txt without a reason file. -->
      <QtNativeBuildReason Condition="'$(QtNativeBuildReason)' == ''"
        >- generated native build state is present</QtNativeBuildReason>
      <_QtNativeBuildHint>Install or configure CMake and a compatible C++ toolchain, or avoid </_QtNativeBuildHint>
      <_QtNativeBuildHint>$(_QtNativeBuildHint)native compilation by exporting all types as metadata (QtExportAs=metadata) </_QtNativeBuildHint>
      <_QtNativeBuildHint>$(_QtNativeBuildHint)and using non-linked resource packaging (QtResourcePackaging=Auto or External).</_QtNativeBuildHint>
    </PropertyGroup>

    <!-- The native host template is native code by definition, whatever the export mode. -->
    <PropertyGroup Condition="'$(QtBridgeIsNativeHostTemplate)' == 'true'">
      <QtNativeBuildReason>- this project builds the native host template</QtNativeBuildReason>
      <_QtNativeBuildHint>Install or configure CMake and a compatible C++ toolchain to build the native host.</_QtNativeBuildHint>
    </PropertyGroup>

    <PropertyGroup Condition="'$(QtHostIsWindows)' == 'true' and '$(VsInstallRoot)' == ''">
      <VsWhereCmd>"$(VsWhereExe)"</VsWhereCmd>
      <VsWhereCmd>$(VsWhereCmd) -latest</VsWhereCmd>
      <VsWhereCmd>$(VsWhereCmd) -products *</VsWhereCmd>
      <VsWhereCmd>$(VsWhereCmd) -requires &quot;$(DesktopWorkload)&quot;</VsWhereCmd>
      <VsWhereCmd>$(VsWhereCmd) -property installationPath</VsWhereCmd>
    </PropertyGroup>
    <Exec Condition="'$(QtHostIsWindows)' == 'true' and '$(VsInstallRoot)' == '' and Exists('$(VsWhereExe)')"
          Command="$(VsWhereCmd)" ConsoleToMsBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" ItemName="VsWhereOutput" />
    </Exec>
    <PropertyGroup Condition="'$(QtHostIsWindows)' == 'true' and '$(VsInstallRoot)' == ''">
      <VsInstallRoot Condition="Exists('%(VsWhereOutput.Identity)')">%(VsWhereOutput.Identity)</VsInstallRoot>
    </PropertyGroup>
    <PropertyGroup>
      <!-- Native arch-specific vcvars script: vcvarsarm64.bat for arm64, vcvars64.bat otherwise -->
      <QtVcVarsScript Condition="'$(QtArch)' == 'arm64'">vcvarsarm64.bat</QtVcVarsScript>
      <QtVcVarsScript Condition="'$(QtVcVarsScript)' == ''">vcvars64.bat</QtVcVarsScript>
      <QtVcVarsCmd Condition="'$(QtHostIsWindows)' == 'true' and '$(VsInstallRoot)' != '' and Exists('$(VsInstallRoot)\VC\Auxiliary\Build\$(QtVcVarsScript)')"
        >CALL "$(VsInstallRoot)\VC\Auxiliary\Build\$(QtVcVarsScript)" &gt; NUL &amp;&amp; </QtVcVarsCmd>
    </PropertyGroup>

    <!-- Probe in the same environment as the CMake calls below; vcvars puts the VS CMake on PATH. -->
    <Exec Command="$(QtVcVarsCmd)&quot;$(QtCMakeExecutable)&quot; --version" ConsoleToMsBuild="true"
      StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="QtCMakeProbeResult" />
    </Exec>
    <Error Condition="'$(QtCMakeProbeResult)' != '0'"
      Text="CMake could not be run from '$(QtCMakeExecutable)'.$(_QtNl)Native compilation is required because:$(_QtNl)$(QtNativeBuildReason)$(_QtNl)$(_QtNativeBuildHint)" />

    <MakeDir Directories="$(QtNativeBuildDir)" />
    <MakeDir Directories="$(QtNativeBinDir)" />

    <PropertyGroup>
      <QtCMakeConfigureCmd Condition="'$(QtHostIsWindows)' == 'true'">$(QtVcVarsCmd)set "CMAKE_PREFIX_PATH=$(QtDir);%CMAKE_PREFIX_PATH%" &amp;&amp; &quot;$(QtCMakeExecutable)&quot; ..\source -DCMAKE_PROJECT_INCLUDE=qtdotnet.cmake -G Ninja -DCMAKE_BUILD_TYPE=$(QtBuildConfig)</QtCMakeConfigureCmd>
      <QtCMakeConfigureCmd Condition="'$(QtHostIsLinux)' == 'true' OR '$(QtHostIsMacOS)' == 'true'">CMAKE_PREFIX_PATH=&quot;$(QtDir):$CMAKE_PREFIX_PATH&quot; &quot;$(QtCMakeExecutable)&quot; ../source -DCMAKE_PROJECT_INCLUDE=qtdotnet.cmake -G Ninja -DCMAKE_BUILD_TYPE=$(QtBuildConfig)</QtCMakeConfigureCmd>
    </PropertyGroup>
    <Exec Command="$(QtCMakeConfigureCmd)" WorkingDirectory="$(QtNativeBuildDir)" EchoOff="true" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="CMakeResult" />
    </Exec>
    <Error Condition="'$(CMakeResult)' != '0'"
      Text="Qt Bridge: native build is required because:$(_QtNl)$(QtNativeBuildReason)$(_QtNl)Native configuration failed; see the CMake output above for details." />

    <PropertyGroup>
      <QtCMakeBuildParallelArgs>--parallel</QtCMakeBuildParallelArgs>
      <QtCMakeBuildParallelArgs Condition="'$(QtBuildParallelism)' != ''"
        >--parallel $(QtBuildParallelism)</QtCMakeBuildParallelArgs>
    </PropertyGroup>
    <Exec Command="$(QtVcVarsCmd)&quot;$(QtCMakeExecutable)&quot; --build . $(QtCMakeBuildParallelArgs)"
      WorkingDirectory="$(QtNativeBuildDir)" EchoOff="true" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="CMakeResult" />
    </Exec>
    <Error Condition="'$(CMakeResult)' != '0'"
      Text="Qt Bridge: native build is required because:$(_QtNl)$(QtNativeBuildReason)$(_QtNl)Native build failed; see the build output above for details." />

    <PropertyGroup>
      <QtNativeHostPath Condition="'$(QtHostIsWindows)' == 'true' and Exists('$(QtNativeBinDir)/$(AssemblyName).exe')">$(QtNativeBinDir)/$(AssemblyName).exe</QtNativeHostPath>
      <QtNativeHostPath Condition="('$(QtHostIsLinux)' == 'true' OR '$(QtHostIsMacOS)' == 'true') and Exists('$(QtNativeBinDir)/$(AssemblyName)')">$(QtNativeBinDir)/$(AssemblyName)</QtNativeHostPath>
    </PropertyGroup>
    <ItemGroup Condition="'$(QtNativeHostPath)' == ''">
      <QtNativeBinary Condition="'$(QtHostIsWindows)' == 'true'" Include="$(QtNativeBinDir)\*.exe" />
      <QtNativeBinary Condition="'$(QtHostIsLinux)' == 'true' OR '$(QtHostIsMacOS)' == 'true'" Include="$(QtNativeBinDir)/*" />
      <QtNativeBinary Remove="@(QtNativeBinary)" Condition="'%(Extension)' == '.so' OR '%(Extension)' == '.dylib' OR '%(Extension)' == '.dll' OR '%(Extension)' == '.a' OR '%(Extension)' == '.json'" />
    </ItemGroup>
    <PropertyGroup>
      <QtNativeHostPath Condition="'$(QtNativeHostPath)' == '' and Exists('%(QtNativeBinary.FullPath)')">%(QtNativeBinary.FullPath)</QtNativeHostPath>
    </PropertyGroup>
    <Error Condition="'$(QtNativeHostPath)' == ''" Text="Error locating native host binary in $(QtNativeBinDir)." />

    <Touch Condition="'$(QtNativeHostPath)' != ''" Files="$(QtNativeHostPath)" />
    <PropertyGroup Condition="'$(QtNativeHostPath)' != ''">
      <AppHostSourcePath>$(QtNativeHostPath)</AppHostSourcePath>
    </PropertyGroup>
  </Target>
  <!-- END QtBridgeBuild-->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgePrepareAppHost
  //
  // Patches the native host template with the Qt Bridge manifest. Patches a
  // private copy, never $(AppHostSourcePath) itself. On the prebuilt-host path
  // that file lives in the package folder and is shared by every project and
  // configuration on the machine.
  //
  // Deliberately not incremental. Skipping this target would also skip the
  // AppHostSourcePath redirection, leaving the SDK to consume an unpatched
  // template. The patch also supplies the SDK app-host marker, so the SDK can
  // apply its normal managed-assembly patch and platform-specific finalisation.
  -->
  <Target Name="QtBridgePrepareAppHost"
    BeforeTargets="_CreateAppHost;_CreateAppHostForPublish"
    DependsOnTargets="QtBridgeBuild;QtBridgePackageResources"
    Condition="'$(QtBridgeIsNativeHostTemplate)' != 'true'
      AND '$(DesignTimeBuild)' != 'true'
      AND '$(AppHostSourcePath)' != '' AND Exists('$(AppHostSourcePath)')">

    <PropertyGroup>
      <!-- compute the path of the private, patched app-host template -->
      <QtBridgePatchedAppHost
      >$(_QtProjectIntermediateDir)/qt_apphost_patched$(_NativeExecutableExtension)</QtBridgePatchedAppHost>
    </PropertyGroup>

    <!-- copy the app-host template to the private, patched location -->
    <Copy SourceFiles="$(AppHostSourcePath)" DestinationFiles="$(QtBridgePatchedAppHost)" />

    <!-- the deployed type metadata -->
    <PropertyGroup>
      <QtBridgeMetadataFile>$(TargetDir)$(QtBridgeMetadataFileName)</QtBridgeMetadataFile>
      <QtBridgeMetadataFile Condition="!Exists('$(QtBridgeMetadataFile)')" />
    </PropertyGroup>

    <!-- the deployed external resource pack -->
    <PropertyGroup>
      <QtBridgeResourcePackFile>$(TargetDir)$(QtBridgeResourcePackFileName)</QtBridgeResourcePackFile>
      <QtBridgeResourcePackFile Condition="!Exists('$(QtBridgeResourcePackFile)')" />
    </PropertyGroup>

    <!-- patch the native host manifest into the app-host template -->
    <PatchNativeHostManifest
      HostPath="$(QtBridgePatchedAppHost)" AssemblyFileName="$(TargetFileName)"
      MetadataFilePath="$(QtBridgeMetadataFile)"
      ResourcePackFilePath="$(QtBridgeResourcePackFile)" />

    <!-- redirect the app-host source path to the patched version -->
    <PropertyGroup>
      <AppHostSourcePath>$(QtBridgePatchedAppHost)</AppHostSourcePath>
    </PropertyGroup>
  </Target>
  <!-- END QtBridgePrepareAppHost-->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgePrepareQmlBuildMetadata
  -->
  <Target Name="QtBridgePrepareQmlBuildMetadata"
    AfterTargets="QtBridgeBuild"
    DependsOnTargets="QtBridgeSetupQml;QtBridgeResolveQtLayout"
    Condition="'$(DesignTimeBuild)' != 'true' AND '$(QtGenSourceCode)' == 'true'" >

    <PropertyGroup>
      <_QtQmllsBuildDir
        >$(_QtProjectNativeBuildDir)</_QtQmllsBuildDir>
      <_QtQmllsSourceDir
        >$(_QtProjectNativeSourceDir)</_QtQmllsSourceDir>
    </PropertyGroup>

    <ItemGroup>
      <_QtQmllsQml Include="@(Qml)">
        <SourcePath>%(FullPath)</SourcePath>
        <ModulePath>%(SourceDir)</ModulePath>
        <TypeName>%(TypeName)</TypeName>
      </_QtQmllsQml>
      <_QtQmllsImportPath Include="$(_QtQmllsBuildDir)/$(QtQmlRootModuleName)" />
      <_QtQmllsGeneratedImportPath
        Include="$(_QtQmllsBuildDir)/$(QtQmlRootModuleName)" />
      <_QtQmllsImportPath Include="$(_QtQmllsSourceDir)/qml" />
      <_QtQmllsImportPath Include="$(QtQmlDir)" Condition="'$(QtQmlDir)' != ''" />
      <_QtQmllsResourceFile Include="$(_QtQmllsBuildDir)/**/*.qrc" />
      <_QtQmllsResourceFile
        Remove="$(_QtQmllsBuildDir)/.qt/qtbridge_project_sources.qrc" />
    </ItemGroup>

    <PrepareQmlBuildMetadata
      ContinueOnError="WarnAndContinue"
      BuildDirectory="$(_QtQmllsBuildDir)"
      GeneratedSourceDirectory="$(_QtQmllsSourceDir)"
      ProjectSourceDirectory="$(MSBuildProjectDirectory)"
      QmlFiles="@(_QtQmllsQml)"
      ImportPaths="@(_QtQmllsImportPath)"
      ResourceFiles="@(_QtQmllsResourceFile)"
      GeneratedImportPaths="@(_QtQmllsGeneratedImportPath)">
      <Output TaskParameter="BuildIniPath" PropertyName="QtQmllsBuildIniPath" />
      <Output
        TaskParameter="ProjectSourcesQrcPath"
        PropertyName="QtQmllsProjectSourcesQrcPath" />
      <Output TaskParameter="BuildIniChanged" PropertyName="_QtQmllsBuildIniChanged" />
      <Output
        TaskParameter="ProjectSourcesQrcChanged"
        PropertyName="_QtQmllsProjectSourcesQrcChanged" />
      <Output TaskParameter="ReadyMarkerPath" PropertyName="QtBuildReadyMarkerPath" />
    </PrepareQmlBuildMetadata>

  </Target>
  <!-- END QtBridgePrepareQmlBuildMetadata -->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeWriteQmlMetadataFile
  //
  // Writes qtbridge-qml.ide.json to obj/[Platform]/[Configuration]/ so that the
  // Qt Bridge Visual Studio extension can configure and start the QML Language
  // Server without inspecting the full MSBuild graph.
  //
  // Timing: AfterTargets="PrepareForBuild" - runs before C# compilation.
  // All required values are evaluated properties; no compiler outputs are needed.
  // The file is rewritten only when its content changes (WriteOnlyWhenDifferent)
  // to avoid spurious file-watcher churn in the extension.
  -->
  <Target Name="QtBridgeWriteQmlMetadataFile" AfterTargets="PrepareForBuild"
    DependsOnTargets="QtBridgeSetupQml;QtBridgeResolveQtLayout"
    Condition="'$(DesignTimeBuild)' != 'true'">

    <PropertyGroup>
      <!-- Absolute paths to the Qt-native source and build directories. -->
      <_QtIdeSrcDir>$(_QtProjectNativeSourceDir)</_QtIdeSrcDir>
      <_QtIdeBldDir>$(_QtProjectNativeBuildDir)</_QtIdeBldDir>

      <!--
        Metadata file directory: obj/[Platform]/[Configuration]/.
        For real platforms (x64, arm64 …), include the platform segment - this matches
        IntermediateOutputPath and what the VS extension resolves via SolutionConfiguration2.
        For Any CPU / AnyCPU / unspecified, use the bare obj/[Configuration]/ path.
        MSBuild uses 'AnyCPU' (no space) internally; Visual Studio passes 'Any CPU'
        (with space) as the platform name. Both must be treated as unqualified so the
        metadata file is written to obj/Debug/ instead of obj/Any CPU/Debug/, matching the
        plain layout MSBuild produces for AnyCPU and the provider's exact-path lookup.
      -->
      <_QtMetadataFileDir
        Condition="'$(Platform)' == ''
                OR '$(Platform)' == 'AnyCPU'
                OR '$(Platform)' == 'Any CPU'"
        >$(_QtProjectBaseIntermediateDir)/$(Configuration)</_QtMetadataFileDir>
      <_QtMetadataFileDir
        Condition="'$(Platform)' != ''
               AND '$(Platform)' != 'AnyCPU'
               AND '$(Platform)' != 'Any CPU'"
        >$(_QtProjectBaseIntermediateDir)/$(Platform)/$(Configuration)</_QtMetadataFileDir>

      <!-- JSON path strings normalized to forward slashes for cross-host consumers. -->
      <_QtIdeJProjFile>$([System.String]::Copy(
        '$(MSBuildProjectFullPath)').Replace('\', '/'))</_QtIdeJProjFile>
      <_QtIdeJProjDir>$([System.String]::Copy(
        '$(ProjectDir)').Replace('\', '/'))</_QtIdeJProjDir>
      <_QtIdeExecutableName Condition="'$(QtHostIsWindows)' == 'true'">$(AssemblyName).exe</_QtIdeExecutableName>
      <_QtIdeExecutableName Condition="'$(QtHostIsWindows)' != 'true'">$(AssemblyName)</_QtIdeExecutableName>
      <_QtIdeJExecutableName>$([System.String]::Copy(
        '$(_QtIdeExecutableName)').Replace('\', '/'))</_QtIdeJExecutableName>
      <_QtIdeJManagedOutputDir>$([System.String]::Copy(
        '$(TargetDir)').Replace('\', '/'))</_QtIdeJManagedOutputDir>
      <_QtIdeJManagedHostPath>$([System.String]::Copy(
        '$(TargetDir)$(_QtIdeExecutableName)').Replace('\', '/'))</_QtIdeJManagedHostPath>
      <_QtIdeJNativeHostPath>$([System.String]::Copy(
        '$(_QtProjectNativeBinDir)/$(_QtIdeExecutableName)').Replace('\', '/'))</_QtIdeJNativeHostPath>
      <_QtIdeJSrcDir>$([System.String]::Copy(
        '$(_QtIdeSrcDir)').Replace('\', '/'))</_QtIdeJSrcDir>
      <_QtIdeJBldDir>$([System.String]::Copy(
        '$(_QtIdeBldDir)').Replace('\', '/'))</_QtIdeJBldDir>
      <_QtIdeJModDir>$([System.String]::Copy(
        '$(_QtIdeBldDir)/$(QtQmlRootModuleName)').Replace('\', '/'))</_QtIdeJModDir>
      <_QtIdeJSourceQmlDir>$([System.String]::Copy(
        '$(_QtIdeSrcDir)/qml').Replace('\', '/'))</_QtIdeJSourceQmlDir>
      <_QtIdeJReadyFile>$([System.String]::Copy(
        '$(_QtIdeBldDir)/.qt/qtbridge-build.ready').Replace('\', '/'))</_QtIdeJReadyFile>
      <_QtIdeJQtQmlDir Condition="'$(QtQmlDir)' != ''">$([System.String]::Copy(
        $([System.IO.Path]::GetFullPath('$(QtQmlDir)'))).Replace('\', '/'))</_QtIdeJQtQmlDir>

      <!--
        importPaths JSON array content (no surrounding brackets).
        Always includes the QML module output directory and the generated source QML
        root for copied QML modules such as QtExampleStyle. Appends the active Qt QML
        directory when $(QtDir) is set,
        suppressing the CI-baked qmlls fallback import path (D:/a/qmlls-workflow/...).
        Written as a compact single-line array in the metadata file.
      -->
      <_QtIdeImportPaths
        Condition="'$(_QtIdeJQtQmlDir)' == ''">"$(_QtIdeJModDir)", "$(_QtIdeJSourceQmlDir)"</_QtIdeImportPaths>
      <_QtIdeImportPaths
        Condition="'$(_QtIdeJQtQmlDir)' != ''">"$(_QtIdeJModDir)", "$(_QtIdeJSourceQmlDir)", "$(_QtIdeJQtQmlDir)"</_QtIdeImportPaths>
    </PropertyGroup>

    <!--
      Create the metadata file directory and both validated directories (sourceDir and
      buildDirs[0]) before writing the metadata file. The extension validates that these
      directories exist on disk before starting the QML Language Server; without this,
      the first watcher notification (fired when the metadata file appears) arrives before
      QtBridgeGenerate/QtBridgeBuild have run, validation fails, and the server never
      starts unless the user manually reopens the QML file after the build completes.
      Empty directories are sufficient - qmlls starts without requiring their contents.
    -->
    <MakeDir Directories="$(_QtMetadataFileDir);$(_QtIdeSrcDir);$(_QtIdeSrcDir)/qml;$(_QtIdeBldDir)" />

    <!--
      Keep the metadata JSON as readable multiline text and let MSBuild expand the
      embedded properties before writing the file. WriteOnlyWhenDifferent prevents
      timestamp changes when nothing has changed, avoiding unnecessary file-watcher
      notifications in the VS extension.
    -->
    <PropertyGroup>
      <_QtMetadataJson><![CDATA[{
  "version": 1,
  "projectFile": "$(_QtIdeJProjFile)",
  "configuration": "$(Configuration)",
  "targetFramework": "$(TargetFramework)",
  "application": {
    "assemblyName": "$(AssemblyName)",
    "executableName": "$(_QtIdeJExecutableName)",
    "managedOutputDir": "$(_QtIdeJManagedOutputDir)",
    "managedHostPath": "$(_QtIdeJManagedHostPath)",
    "nativeHostPath": "$(_QtIdeJNativeHostPath)"
  },
  "qml": {
    "sourceDir": "$(_QtIdeJSrcDir)",
    "projectSourceDir": "$(_QtIdeJProjDir)",
    "buildDirs": [
      "$(_QtIdeJBldDir)"
    ],
    "importPaths": [$(_QtIdeImportPaths)],
    "files": [
@(Qml->'
      { "sourcePath": "%(JsonSourcePath)",
        "uri": "%(Uri)",
        "typeName": "%(TypeName)",
        "modulePath": "%(JsonModulePath)",
        "resourceUrl": "%(JsonResourceUrl)"
      }', ',
')
    ]
  },
  "qmlLanguageServer": {
    "disableCMakeCalls": true,
    "readyFile": "$(_QtIdeJReadyFile)"
  }
}]]></_QtMetadataJson>
    </PropertyGroup>
    <WriteLinesToFile Overwrite="true" WriteOnlyWhenDifferent="true"
      File="$(_QtMetadataFileDir)/qtbridge-qml.ide.json"
      Lines="$(_QtMetadataJson)" />

  </Target>
  <!-- END QtBridgeWriteQmlMetadataFile-->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeDeploy : HostIsWindows
  -->
  <Target Name="QtBridgeDeploy_Windows"
    AfterTargets="CopyFilesToOutputDirectory" DependsOnTargets="QtBridgeBuild"
    Condition="'$(DesignTimeBuild)' != 'true' AND '$(QtHostIsWindows)' == 'true'">

    <Message Importance="high" Text="Qt Bridge: Deploying Qt..." />

    <PropertyGroup Condition="'$(VsInstallRoot)' == ''">
      <VsWhereCmd>"$(VsWhereExe)"</VsWhereCmd>
      <VsWhereCmd>$(VsWhereCmd) -latest</VsWhereCmd>
      <VsWhereCmd>$(VsWhereCmd) -property installationPath</VsWhereCmd>
    </PropertyGroup>
    <Exec Condition="'$(VsInstallRoot)' == '' and Exists('$(VsWhereExe)')"
          Command="$(VsWhereCmd)" ConsoleToMsBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" ItemName="VsWhereOutput" />
    </Exec>
    <PropertyGroup Condition="'$(VsInstallRoot)' == ''">
      <VsInstallRoot Condition="Exists('%(VsWhereOutput.Identity)')"
        >%(VsWhereOutput.Identity)</VsInstallRoot>
    </PropertyGroup>

    <PropertyGroup>
      <!--
        Resolved here, not as a static default, since QtBuildConfig
        may not be final yet at import time for packaged consumers
      -->
      <QtDeployConfig Condition="'$(QtDeployConfig)' == ''">$(QtBuildConfig)</QtDeployConfig>

      <!--
        If we do not have debug binaries installed, fall back to release
        deployment rather than failing the build if they're missing.
      -->
      <_QtDeployConfigWantedDebug Condition="'$(QtDeployConfig)' == 'debug'">true</_QtDeployConfigWantedDebug>
      <QtDeployConfig Condition="'$(QtDeployConfig)' == 'debug' AND !Exists('$(QtDir)\bin\Qt6Cored.dll')"
        >release</QtDeployConfig>

      <!-- Native arch-specific vcvars script: vcvarsarm64.bat for arm64, vcvars64.bat otherwise -->
      <VcVarsScript Condition="'$(QtArch)' == 'arm64'">vcvarsarm64.bat</VcVarsScript>
      <VcVarsScript Condition="'$(VcVarsScript)' == ''">vcvars64.bat</VcVarsScript>
      <VcVarsCmd Condition="'$(VsInstallRoot)' != ''"
        >CALL "$(VsInstallRoot)\VC\Auxiliary\Build\$(VcVarsScript)" &gt; NUL</VcVarsCmd>
      <DeployCmd>"$(QtDir)\bin\windeployqt.exe"</DeployCmd>
      <DeployCmd>$(DeployCmd) --qmldir "$(ProjectDir.TrimEnd('\'))"</DeployCmd>
      <DeployCmd>$(DeployCmd) --no-translations</DeployCmd>
      <DeployCmd Condition="'$(QtDeployConfig)' != 'debug'">$(DeployCmd) --release</DeployCmd>
      <DeployCmd Condition="'$(QtDeployConfig)' == 'debug'">$(DeployCmd) --debug</DeployCmd>
      <DeployCmd>$(DeployCmd) --no-compiler-runtime</DeployCmd>
      <DeployCmd>$(DeployCmd) "$(RunCommand)"</DeployCmd>
      <DeployCmd>$(DeployCmd) &gt; NUL</DeployCmd>
    </PropertyGroup>

    <Warning Condition="'$(_QtDeployConfigWantedDebug)' == 'true' AND '$(QtDeployConfig)' != 'debug'"
      Text="Qt Bridge: Debug Qt binaries not found under '$(QtDir)\bin'; deploying release Qt binaries instead." />

    <ItemGroup>
      <!--
      MSBuild and Visual Studio format for diagnostic messages
      https://learn.microsoft.com/en-us/visualstudio/msbuild/msbuild-diagnostic-format-for-tasks
      -->
      <QtMsgRegex Include="__QtMsgRegex__">
        <Origin>(?:((?:(?![\s-[\r\n]]*:[\s-[\r\n]]+).)+)[\s-[\r\n]]*:[\s-[\r\n]]+)?</Origin>
        <SubCat>((?:(?![\s-[\r\n]]*:[\s-[\r\n]]+).(?!(?i:error|warning)))+)?[\s-[\r\n]]*</SubCat>
        <CatError>((?i:error))[\s-[\r\n]]*</CatError>
        <CatWarn>((?i:warning))[\s-[\r\n]]*</CatWarn>
        <Code>((?:(?![\s-[\r\n]]*:[\s-[\r\n]]+).)+)?</Code>
        <Sep>[\s-[\r\n]]*:[\s-[\r\n]]+</Sep>
        <Text>(?'Text'(?:(?![\s-[\r\n]]*:[\s-[\r\n]]+).)+)</Text>
      </QtMsgRegex>

      <QtMsgRegexIgnore
        Include="Warning: Translations will not be available due to the following error" />
      <!-- Add more patterns to ignore here -->

      <QtMsgRegex>
        <Ignore>@(QtMsgRegexIgnore->'(?!%(Identity))','')</Ignore>
      </QtMsgRegex>
      <QtMsgRegex>
        <Error>^%(Ignore)%(Origin)%(SubCat)%(CatError)%(Code)%(Sep)%(Text)$</Error>
        <Warning>^%(Ignore)%(Origin)%(SubCat)%(CatWarn)%(Code)%(Sep)%(Text)$</Warning>
      </QtMsgRegex>
    </ItemGroup>
    <Exec Condition="Exists('$(QtDir)\bin\windeployqt.exe')"
      Command="
          $(VcVarsCmd)
          $(DeployCmd)"
      IgnoreStandardErrorWarningFormat="true"
      CustomErrorRegularExpression="%(QtMsgRegex.Error)"
      CustomWarningRegularExpression="%(QtMsgRegex.Warning)"
      WorkingDirectory="$(TargetDir)" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="DeployResult" />
    </Exec>
    <Error Condition="Exists('$(QtDir)\bin\windeployqt.exe') and '$(DeployResult)' != '0'"
      Text="Error deploying Qt binaries!" />
    <Exec Condition="Exists('$(QtDir)\bin\windeployqt.exe')" WorkingDirectory="$(TargetDir)"
      IgnoreExitCode="true"
      Command="$(DeployCmd) --list relative &gt; qtdeploy.txt 2&gt; NUL" />

  </Target>
  <!-- END QtBridgeDeploy : HostIsWindows -->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeDeploy : GenSourceCode AND (HostIsLinux OR HostIsMacOS)
  -->
  <Target Name="QtBridgeDeploy_SourceCode_Linux_MacOS"
    AfterTargets="CopyFilesToOutputDirectory" DependsOnTargets="QtBridgeBuild"
    Condition="'$(DesignTimeBuild)' != 'true' AND '$(QtGenSourceCode)' == 'true'
      AND ('$(QtHostIsLinux)' == 'true' OR '$(QtHostIsMacOS)' == 'true')">

    <Message Importance="high" Text="Qt Bridge: Deploying Qt..." />

    <!--
      CMake installs the native host together with its runtime dependencies. Stage that
      installation so only the dependencies reach the managed application's output directory.
    -->
    <PropertyGroup>
      <_QtNativeDeployDir
        >$([MSBuild]::NormalizePath('$(_QtProjectNativeBuildDir)', 'deploy'))</_QtNativeDeployDir>
      <_QtNativeDeployHostName
        >$([System.IO.Path]::GetFileName('$(QtNativeHostPath)'))</_QtNativeDeployHostName>
    </PropertyGroup>
    <RemoveDir Directories="$(_QtNativeDeployDir)" />
    <MakeDir Directories="$(_QtNativeDeployDir)" />

    <Message Importance="high"
      Text="Qt Bridge: deploying runtime dependencies via CMake install." />
    <Exec Command="&quot;$(QtCMakeExecutable)&quot; --install . --prefix &quot;$(_QtNativeDeployDir)&quot;"
      WorkingDirectory="$(_QtProjectNativeBuildDir)" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="DeployResult" />
    </Exec>
    <Error Condition="'$(DeployResult)' != '0' AND '$(QtHostIsLinux)' != 'true'"
      Text="Error deploying Qt binaries with CMake install!" />
    <Error Condition="'$(DeployResult)' != '0' AND '$(QtHostIsLinux)' == 'true'"
      Text="Error deploying Qt binaries with CMake install! If the error mentions RPATH, install patchelf; Qt packages from Linux distributions need it for deployment." />

    <Delete Files="$(_QtNativeDeployDir)/$(_QtNativeDeployHostName)" />
    <RemoveDir Condition="'$(QtHostIsMacOS)' == 'true'"
      Directories="$(_QtNativeDeployDir)/$(_QtNativeDeployHostName).app" />
    <ItemGroup>
      <_QtNativeDeployFile Include="$(_QtNativeDeployDir)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_QtNativeDeployFile)"
      DestinationFiles="@(_QtNativeDeployFile->'$(TargetDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <WriteLinesToFile File="$(TargetDir)qtdeploy.txt" Overwrite="false"
      Lines="@(_QtNativeDeployFile->'%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <!-- END QtBridgeDeploy : GenSourceCode AND (HostIsLinux OR HostIsMacOS) -->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeDeploy : !GenSourceCode AND (HostIsLinux OR HostIsMacOS)
  -->
  <Target Name="QtBridgeDeploy_Metadata_Linux_MacOS"
    AfterTargets="CopyFilesToOutputDirectory" DependsOnTargets="QtBridgeBuild"
    Condition="'$(DesignTimeBuild)' != 'true' AND '$(QtGenSourceCode)' != 'true'
      AND ('$(QtHostIsLinux)' == 'true' OR '$(QtHostIsMacOS)' == 'true')">
    <Warning Text="Qt Bridge: Warning: Deployment not supported." />
    <!-- TODO: Add metadata-only deployment support -->
  </Target>
  <!-- QtBridgeDeploy : !GenSourceCode AND (HostIsLinux OR HostIsMacOS) -->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeDeployQml
  -->
  <Target Name="QtBridgeDeployQml"
    AfterTargets="QtBridgeDeploy_Windows;
      ;QtBridgeDeploy_SourceCode_Linux_MacOS;
      ;QtBridgeDeploy_Metadata_Linux_MacOS"
    Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_QtQmlDeployManifest
        >$(IntermediateOutputPath)qt/csharp/qml-deploy.txt</_QtQmlDeployManifest>
    </PropertyGroup>
    <ReadLinesFromFile Condition="Exists('$(_QtQmlDeployManifest)')"
      File="$(_QtQmlDeployManifest)">
      <Output TaskParameter="Lines" ItemName="_QtPreviouslyDeployedQml" />
    </ReadLinesFromFile>
    <Delete Files="@(_QtPreviouslyDeployedQml->'$(TargetDir)%(Identity)')" />

    <ItemGroup>
      <QmlDeploy Condition="'@(Qml)' != ''"
        Include="$(_QtProjectNativeSourceDir)/qml/%(Qml.SourceDir)*">
        <SourceDir>%(Qml.SourceDir)</SourceDir>
      </QmlDeploy>
      <_QtQmlDeployPath Include="@(QmlDeploy->'%(SourceDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy Condition="'@(QmlDeploy)' != ''"
      SourceFiles="%(Identity)"
      DestinationFolder="$(TargetDir)%(SourceDir)" />
    <WriteLinesToFile File="$(_QtQmlDeployManifest)" Overwrite="true"
      Lines="@(_QtQmlDeployPath)" />
    <WriteLinesToFile Condition="'@(QmlDeploy)' != ''"
      File="$(TargetDir)qtdeploy.txt" Overwrite="false"
      Lines="@(_QtQmlDeployPath)" />
  </Target>
  <!-- END QtBridgeDeployQml -->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeDeployResources
  //
  // QML files are loose-deployed so that the application-directory import path
  // can load them without a native rebuild. Qt.resolvedUrl() therefore resolves
  // relative asset URLs against that loose tree. Mirror QtResource items into
  // the same tree so those URLs reach the same files the qrc copy holds.
  //
  // The deploy path comes from the alias, not the source path: QtBridgeSetupQml
  // remaps root-level QML into $(QtQmlRootModuleName), so a source-derived path
  // would not line up with it.
  //
  // Boundary: only qt/qml/-aliased resources are deployed, to support
  // Qt.resolvedUrl(). Default-aliased (assemblies/...) resources are native
  // resource URLs rather than QML-relative files, and stay qrc-only.
  -->
  <Target Name="QtBridgeDeployResources"
    AfterTargets="QtBridgeDeployQml"
    Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_QtQmlAliasPrefix>qt/qml/</_QtQmlAliasPrefix>
    </PropertyGroup>
    <ItemGroup>
      <QtResourceDeploy Include="@(QtResource)"
        Condition="$([System.String]::Copy('%(QtResource.Alias)').StartsWith('$(_QtQmlAliasPrefix)'))">
        <DeployPath>$([System.String]::Copy('%(QtResource.Alias)').Substring($(_QtQmlAliasPrefix.Length)))</DeployPath>
      </QtResourceDeploy>
    </ItemGroup>
    <Copy Condition="'@(QtResourceDeploy)' != ''"
      SourceFiles="@(QtResourceDeploy->'%(FullPath)')"
      DestinationFiles="@(QtResourceDeploy->'$(TargetDir)%(DeployPath)')"
      SkipUnchangedFiles="true" />
    <WriteLinesToFile Condition="'@(QtResourceDeploy)' != ''"
      File="$(TargetDir)qtdeploy.txt" Overwrite="false"
      Lines="@(QtResourceDeploy->'%(DeployPath)'->Distinct())" />
  </Target>
  <!-- END QtBridgeDeployResources -->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeFinalizeMetadataOnlyBuild
  //
  // In a "metadata-only" build, the QtBridgeBuild target does not run, which can leave certain
  // post-conditions unsatisfied, such as up-to-date output files required for incremental build.
  //
  // The project sources resource file maps the resource paths of the QML files to their sources,
  // so that tools such as QML Preview find the sources of the QML files that the application
  // loads.
  //
  // TO-DO: Generate meaningful content for QML-LS configuration files.
  //
  -->
  <Target Name="QtBridgeFinalizeMetadataOnlyBuild" AfterTargets="QtBridgeDeployResources"
    DependsOnTargets="QtBridgeSetupQml"
    Condition="'$(DesignTimeBuild)' != 'true' AND '$(QtGenSourceCode)' != 'true'">
    <ItemGroup>
      <_QtProjectSourcesQml Include="@(Qml)">
        <SourcePath>%(FullPath)</SourcePath>
        <ModulePath>%(SourceDir)</ModulePath>
        <TypeName>%(TypeName)</TypeName>
      </_QtProjectSourcesQml>
      <QtBridgeFiles Include="$(_QtProjectNativeBuildDir)/.qt/.qmlls.build.ini" />
      <QtBridgeFiles Include="$(_QtProjectNativeBuildDir)/.qt/qtbridge_project_sources.qrc" />
      <QtBridgeFiles Include="$(_QtProjectNativeBuildDir)/.qt/qtbridge-build.ready" />
    </ItemGroup>
    <MakeDir Directories="@(QtBridgeFiles->DirectoryName()->Distinct())" />
    <PrepareQmlBuildMetadata
      ContinueOnError="WarnAndContinue"
      MetadataOnlyBuild="true"
      BuildDirectory="$(_QtProjectNativeBuildDir)"
      GeneratedSourceDirectory="$(_QtProjectNativeSourceDir)"
      ProjectSourceDirectory="$(MSBuildProjectDirectory)"
      QmlFiles="@(_QtProjectSourcesQml)" />
    <!-- Touch the files after writing them; their times are outputs of the up-to-date check. -->
    <Touch Files="@(QtBridgeFiles)" AlwaysCreate="true" />
  </Target>
  <!-- END QtBridgeFinalizeMetadataOnlyBuild -->

  <!--
  //////////////////////////////////////////////////////////////////////////////////////////////////
  // QtBridgeClean
  -->
  <Target Name="QtBridgeClean" AfterTargets="Clean">
    <Delete Files="$(_QtProjectNativeBuildDir)/$(QtBridgeResourcePackFileName);$(TargetDir)$(QtBridgeResourcePackFileName)" />
    <RemoveDir Directories="$(IntermediateOutputPath)qt" />
    <ReadLinesFromFile Condition="Exists('$(TargetDir)qtdeploy.txt')"
      File="$(TargetDir)qtdeploy.txt">
      <Output TaskParameter="Lines" ItemName="QtDeploy"/>
    </ReadLinesFromFile>
    <Delete Files="@(QtDeploy->'$(TargetDir)%(Identity)')" />
    <Delete Files="$(TargetDir)qtdeploy.txt" />
    <RemoveDir Condition="$([System.String]::Copy('%(QtDeploy.Identity)').Contains('\')) OR
                        $([System.String]::Copy('%(QtDeploy.Identity)').Contains('/'))"
       Directories="$(TargetDir)$([System.IO.Path]::GetDirectoryName(%(QtDeploy.Identity)).Replace('\', '/').Split('/')[0])" />
  </Target>
  <!-- END QtBridgeClean-->

</Project>
