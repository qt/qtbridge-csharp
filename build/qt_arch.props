<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <QtArchPropsImported>true</QtArchPropsImported>

    <!-- Determine host architecture if not already set -->
    <QtArch Condition="'$(QtArch)' == ''"
      >$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</QtArch>

    <!-- Normalize architecture -->
    <QtArch Condition="'$(QtArch)' == 'X64'">x64</QtArch>
    <QtArch Condition="'$(QtArch)' == 'Arm64'">arm64</QtArch>
    <QtArch Condition="'$(QtArch)' == 'X86'">x86</QtArch>

  </PropertyGroup>
</Project>
