<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove(qt_version.props))" />
  <Import Project="$([MSBuild]::GetPathOfFileAbove(qt_rid.props))" />
  <Import Project="$([MSBuild]::GetPathOfFileAbove(qt_bridge_package.props))" />

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <QtBuildConfig>$(Configuration)</QtBuildConfig>
  </PropertyGroup>

  <ItemGroup Condition="'$(SolutionName)' != 'qtbridge-csharp'">
    <PackageReference Include="$(QtBridgePackageId)" Version="$(SelectedVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(SolutionName)' == 'qtbridge-csharp'">
    <ProjectReference Include="..\..\..\src\Qt.DotNet.Adapter\Qt.DotNet.Adapter.csproj" />
    <ProjectReference Include="..\..\..\src\Qt.Bridge.CSharp.Build.Tasks\Qt.Bridge.CSharp.Build.Tasks.csproj" />
    <ProjectReference Include="..\..\..\src\Qt.Bridge.CSharp.Generator\Qt.Bridge.CSharp.Generator.csproj" />
    <ProjectReference Include="..\..\..\src\Qt.Bridge.CSharp.Generator.Extensions\Qt.Bridge.CSharp.Generator.Extensions.csproj" />
    <ProjectReference Include="..\..\..\src\Qt.Bridge.CSharp.Generator.MetaFunctions\Qt.Bridge.CSharp.Generator.MetaFunctions.csproj" />
    <ProjectReference Include="..\..\..\src\Qt.Bridge.CSharp.Generator.Rules.Metadata\Qt.Bridge.CSharp.Generator.Rules.Metadata.csproj" />
    <ProjectReference Include="..\..\..\src\Qt.Bridge.CSharp.Generator.Rules.SourceCode\Qt.Bridge.CSharp.Generator.Rules.SourceCode.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Condition="'$(SolutionName)' == 'qtbridge-csharp'" Project="..\..\..\build\Qt.Bridge.targets" />

  <ItemGroup>
    <None Remove="GeneratedCode\**\*" />
    <UpToDateCheckInput Include="..\..\..\include\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="qt_dotnet_types.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
