<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsWindows Condition="'$(IsWindows)' == ''">$([MSBuild]::IsOsPlatform('Windows'))</IsWindows>
    <TargetFramework Condition="'$(IsWindows)' == 'True'">net472</TargetFramework>
    <TargetFramework Condition="'$(IsWindows)' != 'True'">net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest" Version="3.10.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsWindows)' == 'True'">
    <ProjectReference Include="..\..\src\Qt.Bridge.CSharp.VisualStudio.Extension\Qt.Bridge.CSharp.VisualStudio.Extension.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsWindows)' != 'True'">
    <Compile Remove="Test_QmlBuildNotificationSettings.cs" />
    <Compile Remove="Test_QmllsBuildIniPatcher.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
