<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <QtDotNetPropsImported>true</QtDotNetPropsImported>

    <!-- TO_DO: implement detection of Qt installation(s) -->
    <QtDir Condition="'$(QtDir)' == ''">C:\lib\qt\6.8.0\msvc2022_64</QtDir>

    <QtDotNetSolutionDir Condition="'$(SolutionDir)' != '' AND Exists('$(SolutionDir)qtdotnet.sln')"
      >$(SolutionDir)</QtDotNetSolutionDir>
    <QtDotNetSolutionDir Condition="'$(QtDotNetSolutionDir)' == '' AND Exists('$(MSBuildThisFileDirectory)..\..\qtdotnet.sln')"
      >$(MSBuildThisFileDirectory)..\..\</QtDotNetSolutionDir>

    <QtDotNetGen>$(MSBuildThisFileDirectory)qdngen.exe</QtDotNetGen>
    <QtDotNetGen Condition="!Exists('$(QtDotNetGen)') AND '$(QtDotNetSolutionDir)' != ''"
      >$(QtDotNetSolutionDir)src\Qt.DotNet.Generator\bin\$(Configuration)\$(TargetFramework)\qdngen.exe</QtDotNetGen>

    <QtDotNetGenRules>$(MSBuildThisFileDirectory)Qt.DotNet.GenerationRules.dll</QtDotNetGenRules>
    <QtDotNetGenRules Condition="!Exists('$(QtDotNetGenRules)') AND '$(QtDotNetSolutionDir)' != ''"
      >$(QtDotNetSolutionDir)src\Qt.DotNet.GenerationRules\bin\$(Configuration)\$(TargetFramework)\Qt.DotNet.GenerationRules.dll</QtDotNetGenRules>

    <QtDotNetAdapter>$(MSBuildThisFileDirectory)Qt.DotNet.Adapter.dll</QtDotNetAdapter>
    <QtDotNetAdapter Condition="!Exists('$(QtDotNetAdapter)') AND '$(QtDotNetSolutionDir)' != ''"
      >$(QtDotNetSolutionDir)src\Qt.DotNet.Adapter\bin\$(Configuration)\$(TargetFramework)\Qt.DotNet.Adapter.dll</QtDotNetAdapter>

    <QtDotNetLib>$(MSBuildThisFileDirectory)../../include</QtDotNetLib>
    <QtDotNetLib Condition="!Exists('$(QtDotNetLib)/qdotnethost.h') AND '$(QtDotNetSolutionDir)' != ''"
      >$(QtDotNetSolutionDir)include</QtDotNetLib>

    <QtGenCmd>"$(QtDotNetGen)"</QtGenCmd>
    <QtGenCmd>$(QtGenCmd) --ref "$(QtDotNetAdapter)"</QtGenCmd>
    <QtGenCmd>$(QtGenCmd) --rules "$(QtDotNetGenRules)"</QtGenCmd>

    <QtQmlFilesCs>qtdotnet\csharp\QmlFiles.cs</QtQmlFilesCs>
  </PropertyGroup>

  <ItemGroup>
    <!-- Add QML files to the build -->
    <Qml Include="$(ProjectDir)**\*.qml" />
    <!-- Remove copies in output dirs -->
    <Qml Remove="$(ProjectDir)$(BaseOutputPath)**\*.qml" />
    <Qml Remove="$(ProjectDir)$(BaseIntermediateOutputPath)**\*.qml" />
    <!-- Add QML files to up-to-date check of VS -->
    <UpToDateCheckInput Set="Qml" Include="@(Qml)" />
    <UpToDateCheckOutput Set="Qml" Include="$(ProjectDir)$(IntermediateOutputPath)$(QtQmlFilesCs)" />
    <!-- Add reference to source files for incremental build -->
    <QtDotNetNativeSource
      Include="$(IntermediateOutputPath)qtdotnet\native\source\CMakeLists.txt
              ;$(IntermediateOutputPath)qtdotnet\native\source\**\*" />
    <!-- Add reference to build files for incremental build -->
    <QtDotNetNativeBuild
      Include="$(IntermediateOutputPath)qtdotnet\native\build\CMakeCache.txt
              ;$(IntermediateOutputPath)qtdotnet\native\build\**\*" />
  </ItemGroup>

</Project>
