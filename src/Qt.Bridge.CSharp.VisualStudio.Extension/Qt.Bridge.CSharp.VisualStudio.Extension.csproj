<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$([MSBuild]::GetPathOfFileAbove(qt_version.props))" />
  <Import Project="$([MSBuild]::GetPathOfFileAbove(qt_template.targets))" />

  <PropertyGroup>
    <IsWindowsBuild>$([MSBuild]::IsOsPlatform('Windows'))</IsWindowsBuild>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <VssdkCompatibleExtension>true</VssdkCompatibleExtension>
    <NoWarn>$(NoWarn);VSEXTPREVIEW_LSP;VSEXTPREVIEW_SETTINGS</NoWarn>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <RegisterWithCodebase>false</RegisterWithCodebase>
    <!--
      The new extensibility Build SDK disables pkgdef generation by default; re-enable it so
      [PackageRegistration]/[ProvideOptionPage] attributes produce a .pkgdef in the VSIX.
    -->
    <GeneratePkgDefFile Condition="'$(IsWindowsBuild)' == 'true'">true</GeneratePkgDefFile>
    <!--
      RegisterWithCodebase emits a CodeBase entry so VS can locate the assembly when loading
      ExtensionPackage.
    -->
    <RegisterWithCodebase Condition="'$(IsWindowsBuild)' == 'true'">true</RegisterWithCodebase>

    <QtBridgeTemplatesPackageId>QtGroup.Qt.Bridge.CSharp.Templates</QtBridgeTemplatesPackageId>
    <QtBridgeTemplatesPackageFileName
      >$(QtBridgeTemplatesPackageId).$(SelectedVersion).nupkg</QtBridgeTemplatesPackageFileName>
    <QtBridgeTemplatesProjectPath
      >$(MSBuildThisFileDirectory)..\..\nuget\Qt.Bridge.CSharp.Templates\Qt.Bridge.CSharp.Templates.csproj</QtBridgeTemplatesProjectPath>
    <QtBridgeTemplatesPackagePath
      >$(MSBuildThisFileDirectory)..\..\nuget\Qt.Bridge.CSharp.Templates\bin\$(Configuration)\$(QtBridgeTemplatesPackageFileName)</QtBridgeTemplatesPackagePath>
    <VsixBuildNumber Condition="'$(Qt_BuildNum)' != ''">$(Qt_BuildNum)</VsixBuildNumber>
    <VsixBuildNumber Condition="'$(VsixBuildNumber)' == '' AND '$(Qt_Timestamp)' != ''">$(Qt_Timestamp)</VsixBuildNumber>
    <VsixBuildNumber Condition="'$(VsixBuildNumber)' == ''">0</VsixBuildNumber>
    <VsixIdentityVersion>$(Qt_MajorNum).$(Qt_MinorNum).$(Qt_PatchNum).$(VsixBuildNumber)</VsixIdentityVersion>
  </PropertyGroup>

  <Choose>
    <When Condition="'$(IsWindowsBuild)' == 'true'">
      <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <GeneratePkgDefFile>true</GeneratePkgDefFile>
        <RegisterWithCodebase>true</RegisterWithCodebase>
        <UseWPF>true</UseWPF>
        <VsixDeployOnDebug>true</VsixDeployOnDebug>
        <TargetVsixContainerName>Qt.Bridge.CSharp.vsix</TargetVsixContainerName>
        <DefineConstants>$(DefineConstants);WINDOWS_DESKTOP</DefineConstants>
      </PropertyGroup>

      <ItemGroup>
        <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" PrivateAssets="all" />
        <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" PrivateAssets="all" />
        <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" PrivateAssets="all" />
        <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
        <Reference Include="Microsoft.VisualStudio.Utilities" />
      </ItemGroup>
    </When>

    <Otherwise>
      <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
      </PropertyGroup>
    </Otherwise>
  </Choose>

  <ItemGroup>
    <None Remove="GPL-3.0-only.txt" />
    <None Remove=".vsextension\string-resources.json" />
    <None Remove="Templates.pkgdef" />
    <None Remove="qt.ico" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="GPL-3.0-only.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="qt.ico">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Templates.pkgdef">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include=".vsextension\string-resources.json">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Update=".vsextension\string-resources.template.json">
      <IncludeInVSIX>false</IncludeInVSIX>
    </Content>
    <Content Include="Resources\WhatsNew\whatsnew.html">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="QtBridge.registration.json">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Qt.Bridge.CSharp.VisualStudio.Core\Qt.Bridge.CSharp.VisualStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Test_Qt.Bridge.CSharp.VisualStudio.Extension</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="GenerateStringResources" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <QtTemplateToken Remove="@(QtTemplateToken)" />
      <QtTemplateToken Include="__QT_BRIDGE_VERSION__">
        <ReplacementValue>$(VsixIdentityVersion)</ReplacementValue>
      </QtTemplateToken>
    </ItemGroup>

    <QtTemplateFile Template=".vsextension\string-resources.template.json"
                    OutputFileName=".vsextension\string-resources.json"
                    Tokens="@(QtTemplateToken)" />

  </Target>

  <Target Name="EnsureQtBridgeTemplatesPackage"
          BeforeTargets="PreCreateVsixContainer"
          Condition="'$(IsWindowsBuild)' == 'true'">
    <MSBuild Projects="$(QtBridgeTemplatesProjectPath)"
      Targets="Pack"
      Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="PreCreateVsixContainer"
          BeforeTargets="GetVsixSourceItems"
          Condition="'$(IsWindowsBuild)' == 'true'">
    <Error Text="No template package found at '$(QtBridgeTemplatesPackagePath)'."
      Condition="!Exists('$(QtBridgeTemplatesPackagePath)')" />
    <ItemGroup>
      <VSIXSourceItem Include="$(QtBridgeTemplatesPackagePath)">
        <VSIXSubPath>ProjectTemplates\</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>

  <Target Name="UpdateVsixManifestVersion"
          AfterTargets="DetokenizeVsixManifestFile"
          Condition="'$(IsWindowsBuild)' == 'true'">
    <XmlPoke XmlInputPath="$(IntermediateVsixManifest)"
             Query="/vs:PackageManifest/vs:Metadata/vs:Identity/@Version"
             Namespaces="&lt;Namespace Prefix='vs' Uri='http://schemas.microsoft.com/developer/vsx-schema/2011' /&gt;"
             Value="$(VsixIdentityVersion)" />
  </Target>

  <!--
    The SDK source generator emits "format": "directoryPath" for
    Setting.FormattedString(SettingStringFormat.DirectoryPath), but the VS settings renderer
    requires "format": "path" + "pathKind": "folder". Replace=true overwrites the generated
    value with the correct schema. See build\PatchSettingsRegistration.targets.
  -->
  <ItemGroup>
    <SettingsRegistrationPatch Include="qtBridge.qtBridgeQmlLanguageServerLogging.qmllsLogDirectory">
      <Replace>true</Replace>
      <format>path</format>
      <pathKind>folder</pathKind>
    </SettingsRegistrationPatch>
    <SettingsRegistrationPatch Include="qtBridge.qtBridgeQmlLanguageServerLogging.lspLogDirectory">
      <Replace>true</Replace>
      <format>path</format>
      <pathKind>folder</pathKind>
    </SettingsRegistrationPatch>
  </ItemGroup>

  <Import Project="build\PatchSettingsRegistration.targets" />

  <Target Name="ReportNonWindowsStubBuild"
          BeforeTargets="CoreCompile"
          Condition="'$(IsWindowsBuild)' != 'true'">
    <Message Importance="High"
             Text="$(MSBuildProjectName): building placeholder assembly on non-Windows host; VSIX packaging is disabled." />
  </Target>

</Project>
