<Window x:Class="Qt.Bridge.CSharp.VisualStudio.Extension.Diagnostics.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vsColors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
        x:ClassModifier="internal"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MaxHeight="400"
        MaxWidth="600"
        MinHeight="0"
        MinWidth="400"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="0"
        ShowActivated="False">

  <Window.Resources>
    <Style x:Key="ToastActionButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="Height" Value="25" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground"
              Value="{DynamicResource {x:Static vsColors:EnvironmentColors.ToolWindowTextBrushKey}}" />
      <Setter Property="Background"
              Value="{DynamicResource {x:Static vsColors:EnvironmentColors.CommandBarHoverBrushKey}}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder"
                        Property="Background"
                        Value="{DynamicResource {x:Static vsColors:EnvironmentColors.CommandBarMenuItemMouseOverBrushKey}}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder"
                        Property="Background"
                        Value="{DynamicResource {x:Static vsColors:EnvironmentColors.CommandBarMouseDownBackgroundGradientBrushKey}}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border BorderThickness="1"
          CornerRadius="6"
          Padding="18,13,16,16"
          Background="{DynamicResource {x:Static vsColors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
          BorderBrush="{DynamicResource {x:Static vsColors:EnvironmentColors.ToolWindowBorderBrushKey}}">
    <Border.Effect>
      <DropShadowEffect Direction="270" ShadowDepth="3" BlurRadius="14" Opacity="0.28" />
    </Border.Effect>

    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="TitleText"
                   Grid.Column="0"
                   FontWeight="SemiBold"
                   FontSize="18"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource {x:Static vsColors:EnvironmentColors.ToolWindowTextBrushKey}}" />

        <Button x:Name="CloseButton"
                Grid.Column="1"
                Content="x"
                Width="20"
                Height="20"
                Margin="12,-2,0,0"
                VerticalAlignment="Top"
                FontSize="10"
                Cursor="Hand"
                Click="CloseButton_Click"
                Background="Transparent"
                BorderThickness="0"
                Foreground="{DynamicResource {x:Static vsColors:EnvironmentColors.ToolWindowTextBrushKey}}" />
      </Grid>

      <TextBlock x:Name="DetailText"
                 Margin="0,12,0,0"
                 TextWrapping="Wrap"
                 FontSize="12"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource {x:Static vsColors:EnvironmentColors.ToolWindowTextBrushKey}}" />

      <StackPanel x:Name="ActionsPanel"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0,16,0,0" />
    </StackPanel>
  </Border>
</Window>
