<PackageManifest
  Version="2.0.0"
  xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011"
  xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity
      Id="Qt.Bridge.CSharp.VisualStudio"
      Version="1.0"
      Language="en-US"
      Publisher="Qt Group" />
    <DisplayName>Qt Bridge for C#</DisplayName>
    <Description
      xml:space="preserve">QML editor support for Qt Bridge for C# projects in Visual Studio.</Description>
    <License>GPL-3.0-only.txt</License>
    <MoreInfoUrl>https://doc-snapshots.qt.io/qtbridges-dev/qtbridges-csharp-index.html</MoreInfoUrl>
    <GettingStartedGuide>https://doc-snapshots.qt.io/qtbridges-dev/qtbridges-csharp-getting-started.html</GettingStartedGuide>
    <ReleaseNotes>https://raw.githubusercontent.com/qt/qtbridge-csharp/dev/CHANGELOG.md</ReleaseNotes>
    <Icon>qt.ico</Icon>
    <Preview>true</Preview>
    <Tags>Qt QML C# Visual Studio language server completion diagnostics</Tags>
  </Metadata>
  <Installation ExtensionType="VSSDK+VisualStudio.Extensibility">
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency
      Id="Microsoft.Framework.NDP"
      DisplayName="Microsoft .NET Framework"
      d:Source="Manual"
      Version="[4.7.2,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite
      Id="Microsoft.VisualStudio.Component.CoreEditor"
      Version="[17.0,)"
      DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="Templates.pkgdef" />
  </Assets>
</PackageManifest>
