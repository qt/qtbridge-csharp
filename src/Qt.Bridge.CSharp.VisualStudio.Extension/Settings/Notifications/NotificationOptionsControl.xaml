<UserControl x:Class="Qt.Bridge.CSharp.VisualStudio.Extension.Settings.Notifications.NotificationOptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <GroupBox Header="Build notifications"
              VerticalAlignment="Top">
      <Grid Margin="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SettingsFilePathText"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap" />

        <CheckBox x:Name="ShowNotificationsCheckBox"
                  Grid.Row="1"
                  Content="Show missing QML build output notifications"
                  Margin="0,0,0,12"
                  Checked="ShowNotificationsCheckBox_OnChecked"
                  Unchecked="ShowNotificationsCheckBox_OnUnchecked" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">
          <TextBlock Text="Suppressed project expiration days:"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0" />
          <TextBox x:Name="ExpirationDaysTextBox"
                   Width="64"
                   LostFocus="ExpirationDaysTextBox_OnLostFocus"
                   ToolTip="Use 0 to never expire suppressions automatically." />
        </StackPanel>

        <ListView x:Name="SuppressedProjectsList"
                  Grid.Row="3"
                  MinHeight="180"
                  MaxHeight="280"
                  SelectionChanged="SuppressedProjectsList_OnSelectionChanged"
                  SizeChanged="SuppressedProjectsList_OnSizeChanged">
          <ListView.View>
            <GridView>
              <GridViewColumn x:Name="ProjectColumn"
                              Header="Project"
                              DisplayMemberBinding="{Binding DisplayName}"
                              Width="160" />
              <GridViewColumn x:Name="PathColumn"
                              Header="Path"
                              DisplayMemberBinding="{Binding ProjectFilePath}"
                              Width="240" />
            </GridView>
          </ListView.View>
        </ListView>

        <Grid Grid.Row="4"
              MinHeight="23"
              Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock x:Name="StatusText"
                     Grid.Column="0"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap" />

          <Button x:Name="RemoveAllButton"
                  Grid.Column="1"
                  Content="Remove All"
                  MinWidth="90"
                  Margin="8,0,0,0"
                  Click="RemoveAllButton_OnClick" />

          <Button x:Name="RemoveButton"
                  Grid.Column="2"
                  Content="Remove"
                  MinWidth="75"
                  Margin="8,0,0,0"
                  Click="RemoveButton_OnClick" />
        </Grid>
      </Grid>
    </GroupBox>
  </ScrollViewer>
</UserControl>
